<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مسترشوفر"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مرکز عملیات"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_up"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="…"
                android:textColor="@color/ink_inverse"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <View
                android:id="@+id/heroDot"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_dot_up" />

            <TextView
                android:id="@+id/heroText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="در حال بررسی…"
                android:textColor="@color/ink"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uptimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="آپتایم ۲۴ساعت: —"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lastCheckText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="آخرین بررسی: —"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/endpointText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="مسیر اتصال: —"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="سرویس‌ها"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/componentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="اقدامات"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refreshBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_primary"
            android:backgroundTint="@null"
            android:text="بروزرسانی وضعیت"
            android:textAllCaps="false"
            android:textColor="@color/ink_inverse"
            android:textSize="15sp" />

        <Button
            android:id="@+id/restartBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_outline"
            android:backgroundTint="@null"
            android:text="راه‌اندازی مجدد وب‌اپ"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_ghost"
            android:backgroundTint="@null"
            android:text="خروج"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
