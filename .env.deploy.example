# Copy to .env.deploy and fill in (never commit .env.deploy)
DEPLOY_HOST=62.60.191.21
DEPLOY_USER=root
DEPLOY_PASS=

# 0 = systemd (current live), 1 = Docker
USE_DOCKER=0

# On Apple Silicon with USE_DOCKER=1, leave as linux/amd64
# DOCKER_PLATFORM=linux/amd64

# Survive VPS reboot (default on)
ENSURE_AUTOSTART=1
