<div id="rc-sms-toast" class="rc-toast">
    <i class="ti ti-message-check" style="font-size:1.25rem;flex-shrink:0"></i>
    <span>پیامکی حاوی لینک سفر به شماره <strong>@ticket?.PhoneNumber</strong> ارسال شد</span>
</div>

<script>
    (function () {
        var el = document.getElementById('rc-sms-toast');
        if (!el) return;
        var key = 'sms-toast-@ticket?.TicketCode';
        if (sessionStorage.getItem(key)) return;
        sessionStorage.setItem(key, '1');
        setTimeout(function () { el.classList.add('show'); }, 200);
        setTimeout(function () { el.classList.remove('show'); }, 5200);
    })();
</script>

