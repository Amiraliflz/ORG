<script>
    Swal.fire({
        title: 'سفر ثبت شد',
        text: 'سفر با موفقیت ثبت شد.',
        confirmButtonText: 'متوجه شدم',
        icon: 'success',
        customClass: {
            confirmButton: 'btn btn-primary waves-effect waves-light'
        },
        buttonsStyling: false
    });
</script>


