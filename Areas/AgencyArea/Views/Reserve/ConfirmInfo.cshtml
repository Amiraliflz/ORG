@using Application.Models
@{
        Layout = "_AgencySideLayout";
    ViewData["title"] = "تایید نهایی";

    var trip = (Application.Services.MrShooferORS.SearchedTrip)ViewBag.trip;

    var reserve_viemodel = (Application.ViewModels.Reserve.ReserveInfoViewModel)ViewBag.reserveviewmodel;

    var agancy = (Application.Models.Agency)ViewBag.agancy;

    bool isCustomer = ViewBag.IsCustomer ?? false;
    decimal customerBalance = ViewBag.CustomerBalance ?? 0m;
    bool canPayWithBalance = isCustomer && customerBalance >= (decimal)(trip?.afterdiscticketprice ?? int.MaxValue);

    Dictionary<int, string> monthName = new Dictionary<int, string>()
    {
    {1,"فروردین" },
    {2,"اردیبهشت"},
    {3, "خرداد" },
    {4, "تیر" },
    {5,"مرداد"},
    {6, "شهریور" },
    {7, "مهر" },
    {8, "آبان" },
    {9, "آذر" },
    {10, "دی" },
    {11, "بهمن" },
    {12, "اسفند" }
    };

    // Build webapp url if token provided
    string webappToken = string.Empty;
    if (ViewBag.WebappToken != null)
    {
        webappToken = ViewBag.WebappToken as string ?? string.Empty;
    }
    else
    {
        // try dynamic property on reserve_viemodel without causing compile-time error if it doesn't exist
        try
        {
            webappToken = ((dynamic)reserve_viemodel)?.WebappToken ?? string.Empty;
        }
        catch
        {
            webappToken = string.Empty;
        }
    }

    string webappBase = ViewBag.WebappBase as string ?? "https://webapp.mrshoofer.ir";
    string webappUrl = string.Empty;
    if (!string.IsNullOrWhiteSpace(webappToken))
    {
        webappUrl = $"{webappBase}/o?t={System.Net.WebUtility.UrlEncode(webappToken)}";
    }

}

<style>
    @@media (max-width: 767.98px) {
        .downside-contaner {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .confirm-left-col  { order: 1; }
        .confirm-right-col { order: 2; }
    }

    @@media (min-width: 768px) {
        .trip-card-fill {
            display: flex !important;
            flex-direction: column !important;
        }
        .trip-card-fill .trip-price-row {
            margin-top: auto !important;
        }
        .downside-contaner {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto;
            column-gap: 1.5rem;
            row-gap: 1rem;
            align-items: stretch;
        }
        .confirm-header    { grid-column: 1 / -1; grid-row: 1; }
        .confirm-right-col { grid-column: 2; grid-row: 2; display: flex; flex-direction: column; gap: 1rem; }
        .confirm-left-col  { grid-column: 1; grid-row: 2; display: flex; flex-direction: column; gap: 1rem; }
        .confirm-trip      { flex-grow: 1; }
        .confirm-discount  { height: 110px; flex-shrink: 0; display: flex; flex-direction: column; justify-content: center; }
    }

    @@media only screen and (max-width: 600px) {
        .px-14 { padding-left: 0.75rem !important; padding-right: 0.75rem !important; }
        .step-title { font-size: .75rem !important; }
        /* Confirm button full-width on mobile */
        .confirm-btn-wrap { margin-top: .75rem !important; padding-top: 0 !important; }
        .confirm-btn-wrap button { border-radius: 1rem !important; }

        /* ── Trip card mobile fixes ── */

        /* Origin / destination row */
        .mt.pt-3 { margin: 0 !important; padding-top: .5rem !important; }
        .mt.pt-3 .fs-5 { font-size: .95rem !important; }
        .mt.pt-3 small  { font-size: .68rem !important; }

        /* Date / Time / Car — three col-4 columns */
        .col-4.d-flex.flex-column { padding-left: .1rem !important; padding-right: .1rem !important; }
        .col-4.d-flex.flex-column > small { font-size: .62rem !important; text-align: center; }

        /* Stack date + day-of-week vertically so they don't collide */
        .col-4 .d-flex.mt-1 { flex-direction: column !important; align-items: center !important; gap: 0 !important; }
        .col-4 .d-flex.mt-1 span { font-size: .8rem !important; margin: 0 !important; }

        /* Time value */
        .col-4 .text-blck.fs-5.mt-1 { font-size: .8rem !important; text-align: center; }
        .col-4 .text-blck.fs-5.mt-1 small { font-size: .68rem !important; }

        /* Car badge */
        .carmodel { font-size: .62rem !important; padding: .15rem .4rem !important; }

        /* Price row */
        .col-12.mt-4 .d-flex[style*="space-between"] { flex-direction: column !important; gap: .2rem; }
        .col-12.mt-4 h5 { font-size: .95rem !important; margin-bottom: .1rem !important; }
        .col-12.mt-4 h4 { font-size: 1.1rem !important; }
        .col-12.mt-4 small { font-size: .65rem !important; }
    }

</style>

