                                                        </symbol>
                                                    </use>
                                                </svg>@trip.originalTicketprice.ToString("N0")
                                            </bdi>
                                        </s>
                                    </h5>
                                </div>
                            }


                            <h4 class="text-primary mb-1 text-end">
                                <bdi>
                                    <svg class="toman">
