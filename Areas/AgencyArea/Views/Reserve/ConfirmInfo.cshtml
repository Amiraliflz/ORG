@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/animate-css/animate.css">
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}
@section PageScripts {
    <script src="~/js/ui-modals.js"></script>
}

<div class="main_container px-lg-6 px-0">
    <div class="bg-white rounded-5 border-1 border-divider w-full rounded-3xl py-7.5 px-14 shadow-1__2__gray/75 ">

        <div class="d-flex steps">
            <div class="step-container">
                <div class="step">
                    <i class="ti ti-checks ti-lg px-4 d:pb-4 text-success"></i>

                    @* <img src="/ok.png" height="40px;" /> *@
                    <span class="pt-1 step-title">
                        اطلاعات مسافر
                    </span>
                </div>
                <div class="h-[0.063rem] flex-1  bg-divider"></div>
            </div>

            <div class="step-container selected">
                <div class="step">
                    <i class="ti ti-certificate ti-lg px-4 d:pb-4"></i>
                    <span class="pt-1 step-title ">
                        رزور و تایید
                    </span>
                </div>
                <div class="h-[0.063rem] flex-1  bg-divider"></div>
            </div>

            <div class="step-container">
                <div class="step">
                    <i class="ti ti-credit-card ti-lg px-4 d:pb-4 "></i>
                    <span class="pt-1 step-title">
                        پرداخت
                    </span>
                </div>
                <div class="h-[0.063rem] flex-1  bg-divider"></div>
            </div>

            <div class="step-container" style="flex: none;">
                <div class="step">
                    <i class="ti ti-ticket ti-lg px-4 d:pb-4"></i>
                    <span class="pt-1 step-title">
                        صدور
                    </span>
                </div>
            </div>
        </div>

    </div>

    @{
        ViewData["NorthNoticeOrigin"] = trip?.originCityName;
        ViewData["NorthNoticeDestination"] = trip?.destinationCityName;
        if (trip is not null)
            ViewData["NorthNoticeDate"] = trip.startingDateTime;
    }
    <div class="mt-4">
        @await Html.PartialAsync("~/Areas/AgencyArea/Views/Shared/_NorthRoutePriceNotice.cshtml")
    </div>

    <div class="downside-contaner mt-4">
        <div class="mb-4 confirm-header">

            <div class="d-flex justify-content-between align-items-baseline">
              <div>

                <h2 class="mb-2 font-bold" style="font-size: 1.5rem; line-height: 2rem; --tw-text-opacity: 1; color: rgb(41 38 61 / var(--tw-text-opacity));">تایید اطلاعات و رزرو</h2>
                <small>اطلاعات مسافر و سفر را تایید نهایی کنید</small>
              </div>

                <span onclick="window.history.back();">
                    بازگشت
                    <i class="ti ti-arrow-back-up"></i>
                </span>
            </div>

            
        </div>


        <div class="confirm-right-col">
            <div class="card rounded-5 p-3 trip-card-fill confirm-trip">

                <div class="d-flex align-items-center mb-3">
                    <img class="d-inline" src="/taxiloc.png" height="40px" />
                    <h5 class="ms-2 mb-0 fw-bold">سفر</h5>
                </div>

                <div class="headline d-flex justify-between">
                    <span class="badge bg-dark rounded-pill py-2" style="font-size: .875rem!important">
                        @trip.taxiSupervisorName
                    </span>
                    <div class="capacity badge bg-label-secondary rounded-pill">
                        <i class="ti ti-armchair-2 d-inline"></i>
                        |
                        @* <span class="badge bg-label-danger">دربتسی</span> *@
                        <small class="text-danger ms-1 d-inline t-bold">دربستی</small>
                    </div>
                </div>


                @* مبدا و مقصد *@
                <div class="mt pt-3 col-12 d-flex px-md-5 px-1 m-2" style="justify-content: space-between;">
                    <span>
                        <small class="d-block ms-1 ">
                            <img src="/redpin.png" height="18px;" />
                            مبدا
                        </small>
                        <span class="fs-5 text-blck">
                            @trip.originCityName
                        </span>
                        <small>
                            @trip.oringinLocationName
                        </small>
                    </span>

                    <span style="align-self: end;" class="mb-1">
                        <span>
                            ....
                        </span>
                        <img src="/taxi.png" height="30px" />
                        <span>
                            ....
                        </span>
                    </span>

                    <span>
                        <small class="d-block ms-1 ">
                            <img src="/redpin.png" height="18px;" />
                            مقصد
                        </small>
                        <span class="fs-5 text-blck">
                            @trip.destinationCityName
                        </span>
                        <small>
                            @trip.destinationLocationName
                        </small>
                    </span>
                </div>

                <hr />
                @* تاریخ و خودرو *@


                @{
                    var pdate = new Application.Services.PersianDate(trip.startingDateTime);
                    var models = (trip.carModelName ?? string.Empty).Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                    string timeOfDay = trip.startingDateTime.Hour <= 11 ? "صبح"
                                     : trip.startingDateTime.Hour < 15 ? "ظهر"
                                     : trip.startingDateTime.Hour <= 19 ? "بعداز ظهر"
                                     : "شب";
                }
                <div class="d-flex flex-column gap-2 px-1">

                    <div class="d-flex justify-content-between align-items-center py-2 px-2 rounded-3" style="background:#f6f6f6">
                        <small class="text-muted"><i class="ti ti-calendar-event me-1"></i>تاریخ سفر</small>
                        <span class="fw-semibold text-blck">@pdate.Day @monthName[pdate.Month] — @pdate.DayOfWeek</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 px-2 rounded-3" style="background:#f6f6f6">
                        <small class="text-muted"><i class="ti ti-clock me-1"></i>ساعت حرکت</small>
                        <span class="fw-semibold text-blck">@trip.startingDateTime.ToString("HH:mm") <small class="text-muted">(@timeOfDay)</small></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 px-2 rounded-3" style="background:#f6f6f6">
                        <small class="text-muted">
                            <i class="ti ti-car me-1"></i>خودرو
                            @if (trip.taxiSupervisorID == 7) { <img src="/vip_badge.png" style="height:18px;vertical-align:middle"> }
                        </small>
                        <span>
                            @foreach (var m in models)
                            {
                                <span class="badge bg-label-primary rounded-pill carmodel me-1">@m</span>
                            }
                        </span>
                    </div>

                </div>

                <!-- Trip feature highlight -->
                <div class="mt-3 d-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background:#f3f3f3">
                    <i class="ti ti-certificate-2" style="color:#000000;font-size:1.05rem;flex-shrink:0"></i>
