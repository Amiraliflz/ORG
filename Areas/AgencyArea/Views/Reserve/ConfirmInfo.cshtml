                .pm-card-disabled { border-radius:1rem; border:2px solid #f0f0f0; background:#fafafa; padding:.85rem .75rem; opacity:.5; cursor:not-allowed; display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
