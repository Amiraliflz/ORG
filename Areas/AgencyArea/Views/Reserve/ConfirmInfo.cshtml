                                    @if (trip.afterdiscticketprice != trip.originalTicketprice)
                                    {
                                        <div class="text-muted text-decoration-line-through" style="font-size:.8rem">@trip.originalTicketprice.ToString("N0") تومان</div>
                                    }
                                    <span class="fw-bold text-primary" style="font-size:1.05rem" id="modal-final-price">@trip.afterdiscticketprice.ToString("N0")</span>
                                    <small class="text-muted"> تومان</small>
                                    <div id="modal-discount-badge" style="display:none;font-size:.75rem" class="text-success mt-1"></div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer d-flex justify-content-between mt-0">
                        <button class="btn btn-label-secondary p-3 px-3" data-bs-dismiss="modal" type="button">بستن</button>

                        <form method="post" action="/Reserve/ConfirmInfo" id="payment-form">
                            <input name="Tripcode" id="tripcode" type="hidden" value="@reserve_viemodel?.TripCode" />
                            <input name="Firstname" id="firstname" type="hidden" value="@reserve_viemodel?.Firstname" />
                            <input name="Lastname" id="lastname" type="hidden" value="@reserve_viemodel?.Lastname" />
                            <input name="Numberphone" id="numberphone" type="hidden" value="@reserve_viemodel?.NumebrPhone" />
                            <input name="Nacode" id="nacode" type="hidden" value="@reserve_viemodel?.NaCode" />
                            <input name="Gender" type="hidden" value="@reserve_viemodel?.Gender" />
                            <input name="WebappToken" id="webapptoken" type="hidden" value="@webappToken" />
                            <input name="PaymentMethod" id="payment-method" type="hidden" value="zarinpal" />
                            <input name="DiscountCode" id="discount-code-hidden" type="hidden" value="" />

                            <button class="btn btn-primary btn-lg" type="submit" id="confirm-btn">
                                <i class="ti ti-credit-card me-1"></i> تایید و پرداخت
                            </button>
                        </form>

                        @if (!string.IsNullOrWhiteSpace(webappUrl))
                        {
                            <a class="btn btn-outline-primary btn-lg ms-2" href="@webappUrl" role="button">رفتن به وب‌اپ</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div style="height: 10vh;">
</div>

<script>
    var currentPaymentMethod = 'zarinpal';

    function selectPaymentMethod(method) {
        currentPaymentMethod = method;
        document.getElementById('payment-method').value = method;

        // update both desktop and mobile copies
        var ids = ['pm-card-online', 'pm-card-online-m'];
        var balIds = ['pm-card-balance', 'pm-card-balance-m'];
        var confirmBtn = document.getElementById('confirm-btn');

        var pmLabel = document.getElementById('modal-pm-label');
        if (method === 'balance') {
            ids.forEach(function(id){ var el=document.getElementById(id); if(el) el.className='pm-card'; });
            balIds.forEach(function(id){ var el=document.getElementById(id); if(el) el.className='pm-card pm-sel-green'; });
            if (confirmBtn) confirmBtn.innerHTML = '<i class="ti ti-wallet me-1"></i> تایید و پرداخت از کیف پول';
            if (pmLabel) pmLabel.innerHTML = '<i class="ti ti-wallet me-1 text-success"></i>کیف پول';
        } else {
            ids.forEach(function(id){ var el=document.getElementById(id); if(el) el.className='pm-card pm-sel-purple'; });
            balIds.forEach(function(id){ var el=document.getElementById(id); if(el) el.className='pm-card'; });
            if (confirmBtn) confirmBtn.innerHTML = '<i class="ti ti-credit-card me-1"></i> تایید و پرداخت';
            if (pmLabel) pmLabel.innerHTML = '<i class="ti ti-credit-card me-1 text-primary"></i>درگاه پرداخت آنلاین';
        }
    }

    function ChangeNumber() {
        var newPhoneNumber = document.getElementById('newnumberphone').value;
        document.getElementById('numberphone').value = newPhoneNumber;
        document.getElementById('numberphone_display').innerText = newPhoneNumber;
        var modal = bootstrap.Modal.getInstance(document.getElementById('modalCenter'));
        modal.hide();
    }

    var _originalPrice = @trip.afterdiscticketprice;
    var _appliedDiscount = 0;

    function applyDiscount(source) {
        var inputId = source === 'desktop' ? 'discount-input-desktop' : 'discount-input-mobile';
        var msgId   = source === 'desktop' ? 'discount-msg-desktop' : 'discount-msg-mobile';
        var code    = document.getElementById(inputId).value.trim().toUpperCase();
        var msgEl   = document.getElementById(msgId);

        if (!code) { showDiscountMsg(msgEl, 'کد تخفیف را وارد کنید.', false); return; }

        var userPhone = (document.getElementById('numberphone_display')?.innerText || '').trim();
        fetch('/Reserve/ValidateDiscount', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: code, originalPrice: _originalPrice, userPhone: userPhone })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.valid) {
                _appliedDiscount = data.discountPercent;
                document.getElementById('discount-code-hidden').value = code;

                // Sync both inputs
                ['discount-input-desktop','discount-input-mobile'].forEach(function(id){
                    var el = document.getElementById(id); if (el) el.value = code;
                });

                // Update modal price display
                var formatted = Number(data.discountedPrice).toLocaleString('en-US');
                var modalPrice = document.getElementById('modal-final-price');
                if (modalPrice) modalPrice.textContent = formatted;

                var badge = document.getElementById('modal-discount-badge');
                if (badge) { badge.textContent = data.discountPercent + '٪ تخفیف اعمال شد'; badge.style.display = ''; }

                // Update inline price summaries in payment cards
                var dp = document.getElementById('desktop-final-price');
                if (dp) dp.textContent = formatted;
                var mp = document.getElementById('mobile-final-price');
                if (mp) mp.textContent = formatted;

                // Show crossed-out original price now that a discount is active
                var dop = document.getElementById('desktop-original-price');
                if (dop) dop.style.display = '';
                var mop = document.getElementById('mobile-original-price');
                if (mop) mop.style.display = '';

                // Show success in both message areas
                var msg = 'کد تخفیف ' + data.discountPercent + '٪ اعمال شد. قیمت نهایی: ' + formatted + ' تومان';
                ['discount-msg-desktop','discount-msg-mobile'].forEach(function(id){
                    showDiscountMsg(document.getElementById(id), msg, true);
                });
            } else {
                showDiscountMsg(msgEl, data.message || 'کد تخفیف معتبر نیست.', false);
            }
        })
        .catch(function() {
            showDiscountMsg(msgEl, 'خطا در بررسی کد تخفیف.', false);
        });
    }

    function showDiscountMsg(el, text, success) {
        if (!el) return;
        el.textContent = text;
        el.style.color  = success ? '#28c76f' : '#ff4c51';
        el.style.display = '';
    }
</script>


