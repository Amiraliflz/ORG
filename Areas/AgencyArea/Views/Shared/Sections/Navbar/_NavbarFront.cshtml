@{
	TempData.Keep();

	string? currentPage = ViewContext.HttpContext.Request.Path;
	string? partnerBrand = Context.Request.Cookies["partner_brand"];
}

@{
	// Partner logo config — add new partners here
	var partnerLogos = new Dictionary<string, (string Src, string Alt)>(StringComparer.OrdinalIgnoreCase)
	{
		["isic"] = ("~/img/partners/isic-logo.png", "ISIC")
	};
	partnerLogos.TryGetValue(partnerBrand ?? "", out var partner);
}

<style>
	[dir=rtl] .dropdown-menu-end[data-bs-popper] {
		left: 0 !important;
		right: auto !important;
	}

	@@media (max-width: 767.98px) {
		.layout-navbar .navbar-nav .nav-item.dropdown .dropdown-menu {
			left: 0.9rem !important;
		}
	}
</style>

<!-- Navbar: Start -->
<nav class="layout-navbar shadow-none py-0 d-block">
	<div class="container">
		<div class="navbar navbar-expand-lg landing-navbar px-md-3 shadow p-0 px-1 p-md-2 " style="background:rgba(255, 255, 255, 1 );">
			<!-- Menu logo wrapper: Start -->
			<div class="navbar-brand app-brand demo d-flex py-0 py-lg-2 me-4">
				<!-- Mobile menu toggle: Start-->
				<button class="navbar-toggler border-0 px-0 me-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<i class="ti ti-menu-2 ti-sm align-middle"></i>
				</button>
				<!-- Mobile menu toggle: End-->
				<a asp-controller="Home" asp-action="Index" class="app-brand-link d-flex align-items-center gap-2">
					<img src="~/logo_full_b.png" height="34" alt="مسترشوفر" />
					@if (partner.Src != null)
					{
						<span style="width:1px;height:28px;background:#ddd;display:inline-block;margin:0 4px"></span>
						<img src="@Url.Content(partner.Src)" height="32" alt="@partner.Alt" style="object-fit:contain" />
					}
				</a>
			</div>
			<!-- Menu logo wrapper: End -->
			<!-- Menu wrapper: Start -->
			<div class="collapse navbar-collapse landing-nav-menu" id="navbarSupportedContent">
				<button class="navbar-toggler border-0 text-heading position-absolute end-0 top-0 scaleX-n1-rtl" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<i class="ti ti-x ti-sm"></i>
				</button>
				<ul class="navbar-nav me-auto p-3 p-lg-0">

					<li class="nav-item">
						<a class="fw-medium btn btn-primary " asp-area="AgencyArea" asp-controller="Home" asp-action="Index">
							<span>
								<i class="ti ti-ticket"></i>
								سفر جدید
							</span>
						</a>
					</li>

					<li class="nav-item">
						@if (User.HasClaim("Role", "Customer"))
						{
							<a class="nav-link fw-medium" asp-area="AgencyArea" asp-controller="Customer" asp-action="MyProfile">
								<span><i class="ti ti-user-circle"></i> پروفایل من</span>
							</a>
						}
						else if (User.Identity?.IsAuthenticated == true)
						{
							<a class="nav-link fw-medium" asp-area="AgencyArea" asp-controller="Agency" asp-action="Index">
								<span><i class="ti ti-home"></i> پروفایل من</span>
							</a>
						}
						else
						{
							<a class="nav-link fw-medium" asp-area="AgencyArea" asp-controller="Auth" asp-action="CustomerLogin"
							   asp-route-ReturnUrl="/Customer/MyProfile">
								<span><i class="ti ti-user-circle"></i> پروفایل من</span>
							</a>
						}
					</li>

					<li class="nav-item">
						@if (User.HasClaim("Role", "Customer"))
						{
							<a class="nav-link fw-medium" asp-area="AgencyArea" asp-controller="Customer" asp-action="MyTickets">
								<span><i class="ti ti-ticket"></i> سفرهای من</span>
							</a>
						}
						else
						{
							<a class="nav-link fw-medium" asp-area="AgencyArea" asp-controller="TicketInfo" asp-action="Index">
								<span><i class="ti ti-certificate-2"></i> سفرهای من</span>
							</a>
						}
					</li>
					<li class="nav-item">
						<a class="nav-link fw-medium" asp-area="AgencyArea" asp-controller="Home" asp-action="ContactUs">
							<span>
								<i class="ti ti-heart-handshake"></i>
								پشتیبانی 24/7
							</span>
						</a>
					</li>
				</ul>
			</div>
			<div class="landing-menu-overlay d-lg-none"></div>
			<!-- Menu wrapper: End -->
			<!-- Toolbar: Start -->
			<ul class="navbar-nav flex-row align-items-center ms-auto">

				<!-- Style Switcher -->
				@* <li class="nav-item dropdown-style-switcher dropdown me-2 me-xl-0">
				<a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
				<i class='ti ti-sm'></i>
				</a>
				<ul class="dropdown-menu dropdown-menu-end dropdown-styles">
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="light">
				<span class="align-middle"><i class='ti ti-sun me-2'></i>روز</span>
				</a>
				</li>
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="dark">
				<span class="align-middle"><i class="ti ti-moon me-2"></i>شب</span>
				</a>
				</li>
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="system">
				<span class="align-middle"><i class="ti ti-device-desktop me-2"></i>سیستم</span>
				</a>
				</li>
				</ul>
				</li> *@
				<!-- / Style Switcher-->
				<!-- navbar button: Start -->
				<li>

					@{
						if (User.Identity.IsAuthenticated)

						{
						<li class="nav-item navbar-dropdown dropdown-user dropdown">
							<a class="nav-link dropdown-toggle hide-arrow show" data-bs-toggle="dropdown" href="javascript:void(0);" aria-expanded="true">
								<span style="width:36px;height:36px;border-radius:50%;background:#696cff;display:inline-flex;align-items:center;justify-content:center;">
								<i class="ti ti-user" style="color:#fff;font-size:1.1rem;"></i>
							</span>
							</a>
							<ul class="dropdown-menu dropdown-menu-end" data-bs-popper="static">

								@if (User.HasClaim("Role", "Customer"))
								{
									<li>
										<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Customer" asp-action="MyProfile">
											<i class="ti ti-user-check me-2 ti-sm"></i>
											<span class="align-middle">پروفایل من</span>
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Customer" asp-action="MyTickets">
											<i class="ti ti-ticket me-2 ti-sm"></i>
											<span class="align-middle">سفرهای من</span>
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Customer" asp-action="MyWallet">
											<i class="ti ti-wallet me-2 ti-sm"></i>
											<span class="align-middle">کیف پول</span>
										</a>
									</li>
								}
								else
								{
									<li>
										<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Agency" asp-action="Index">
											<i class="ti ti-user-check me-2 ti-sm"></i>
											<span class="align-middle">پروفایل من</span>
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="AgencyArea" asp-controller="TicketInfo" asp-action="Index">
											<i class="ti ti-ticket me-2 ti-sm"></i>
											<span class="align-middle">سفرهای من</span>
										</a>
									</li>
								}

								<li><div class="dropdown-divider"></div></li>

								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Home" asp-action="ContactUs">
										<i class="ti ti-heart-handshake me-2 ti-sm"></i>
										<span class="align-middle">پشتیبانی 24/7</span>
									</a>
								</li>

								<li><div class="dropdown-divider"></div></li>

								<li>
									<form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
										@Html.AntiForgeryToken()
										<button type="submit" class="dropdown-item">
											<i class="ti ti-logout me-2 ti-sm"></i>
											<span class="align-middle text-danger">خروج از حساب</span>
										</button>
									</form>
								</li>
							</ul>
						</li>

						}

						else

						{
						<a asp-area="AgencyArea" asp-controller="Auth" asp-action="CustomerLogin" class="btn btn-primary">
							<span class="tf-icons ti ti-login scaleX-n1-rtl me-md-1"></span>
							<span class="d-none d-md-block">ورود / ثبت‌نام</span>
						</a>
						}
					}
				</li>

				<!-- navbar button: End -->
			</ul>
		</div>
	</div>
</nav>
