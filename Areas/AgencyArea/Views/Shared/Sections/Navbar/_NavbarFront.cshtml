@{
	TempData.Keep();

	string? currentPage = ViewContext.HttpContext.Request.Path;
	string? partnerBrand = Context.Request.Cookies["partner_brand"];
	var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@{
	// Partner logo config — add new partners here
	var partnerLogos = new Dictionary<string, (string Src, string Alt)>(StringComparer.OrdinalIgnoreCase)
	{
		["isic"] = ("~/img/partners/isic-logo.png", "ISIC")
	};
	partnerLogos.TryGetValue(partnerBrand ?? "", out var partner);
}

<style>
	[dir=rtl] .dropdown-menu-end[data-bs-popper] {
		left: 0 !important;
		right: auto !important;
	}

	@@media (max-width: 767.98px) {
		.layout-navbar .navbar-nav .nav-item.dropdown .dropdown-menu {
			left: 0.9rem !important;
		}

		.navbar.landing-navbar {
			padding-inline: 0.75rem !important;
			padding-block: 0.22rem !important;
			margin-inline: 0.75rem;
			border-radius: 1.35rem;
		}

		.landing-navbar .navbar-brand {
			margin-inline-end: 0.5rem !important;
		}

		.landing-navbar .navbar-login-btn > span {
			display: none !important;
		}
	}

	.landing-nav-row {
		--landing-nav-gap: 0.625rem;
		gap: var(--landing-nav-gap) !important;
	}

	.landing-nav-row > .nav-item {
		margin: 0;
	}

	@@media (min-width: 992px) {
		.landing-nav-menu--guest {
			flex-grow: 1;
			justify-content: center;
		}
	}

	/* Prevent contact/profile dropdown flash before front-palette.css loads */
	.landing-navbar .landing-nav-dropdown-menu:not(.show) {
		display: none !important;
	}
</style>

<!-- Navbar: Start -->
<nav class="layout-navbar shadow-none py-0 d-block">
	<div class="container">
		<div class="navbar navbar-expand-lg landing-navbar px-md-3 shadow p-0 px-1 p-md-2 " style="background:rgba(255, 255, 255, 1 );">
			<!-- Menu logo wrapper: Start -->
			<div class="navbar-brand app-brand demo d-flex align-items-center py-0 me-4">
				<!-- Mobile menu toggle: Start-->
				<button class="navbar-toggler border-0 px-0 me-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<i class="ti ti-menu-2 ti-sm align-middle"></i>
				</button>
				<!-- Mobile menu toggle: End-->
				<a asp-controller="Home" asp-action="Index" class="app-brand-link d-flex align-items-center gap-2">
					<span class="landing-brand-stack">
						<img src="~/logo_full_b.webp" width="151" height="34" alt="مستر شوفر" decoding="async" />
					</span>
					@if (partner.Src != null)
					{
						<span style="width:1px;height:28px;background:#ddd;display:inline-block;margin:0 4px"></span>
						<img src="@Url.Content(partner.Src)" height="32" alt="@partner.Alt" style="object-fit:contain" />
					}
				</a>
			</div>
			<!-- Menu logo wrapper: End -->
			<!-- Menu wrapper: Start -->
			<div class="collapse navbar-collapse landing-nav-menu @(isAuthenticated ? "landing-nav-menu--auth" : "landing-nav-menu--guest") d-lg-flex align-items-lg-center flex-lg-grow-1" id="navbarSupportedContent">
				<div class="landing-nav-drawer">
					<div class="landing-nav-drawer__head d-lg-none">
						<span class="landing-nav-drawer__title">
							<i class="ti ti-menu-2" aria-hidden="true"></i>
							<span>منو</span>
						</span>
						<button type="button"
								class="landing-nav-drawer__close"
								data-bs-toggle="collapse"
								data-bs-target="#navbarSupportedContent"
								aria-controls="navbarSupportedContent"
								aria-label="بستن">
							<i class="ti ti-x" aria-hidden="true"></i>
						</button>
					</div>

					<div class="landing-nav-drawer__body">
						@if (isAuthenticated)
						{
							<ul class="navbar-nav landing-nav-row me-auto p-3 p-lg-0 align-items-center flex-wrap">
								<li class="nav-item">
									<a class="fw-medium btn btn-sm btn-primary navbar-nav-btn" asp-area="AgencyArea" asp-controller="Home" asp-action="Index">
										<span>
											<i class="ti ti-ticket"></i>
											سفر جدید
										</span>
									</a>
								</li>

								<li class="nav-item">
									@if (User.HasClaim("Role", "Customer"))
									{
										<a class="fw-medium btn btn-sm btn-primary navbar-nav-btn" asp-area="AgencyArea" asp-controller="Customer" asp-action="MyTickets">
											<span><i class="ti ti-ticket"></i> سفرهای من</span>
										</a>
									}
									else
									{
										<a class="fw-medium btn btn-sm btn-primary navbar-nav-btn" asp-area="AgencyArea" asp-controller="TicketInfo" asp-action="Index">
											<span><i class="ti ti-certificate-2"></i> سفرهای من</span>
										</a>
									}
								</li>

								<partial name="Sections/_SiteNavLinks" />
							</ul>
						}
						else
						{
							<ul class="navbar-nav landing-nav-row p-3 p-lg-0 align-items-center">
								<partial name="Sections/_SiteNavLinks" />
							</ul>
						}
					</div>
				</div>
			</div>
			<div class="landing-menu-overlay d-lg-none" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-hidden="true"></div>
			<!-- Menu wrapper: End -->
			<!-- Toolbar: Start -->
			<ul class="navbar-nav flex-row align-items-center ms-auto">

				<!-- Style Switcher -->
				@* <li class="nav-item dropdown-style-switcher dropdown me-2 me-xl-0">
				<a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
				<i class='ti ti-sm'></i>
				</a>
				<ul class="dropdown-menu dropdown-menu-end dropdown-styles">
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="light">
				<span class="align-middle"><i class='ti ti-sun me-2'></i>روز</span>
				</a>
				</li>
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="dark">
				<span class="align-middle"><i class="ti ti-moon me-2"></i>شب</span>
				</a>
				</li>
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="system">
				<span class="align-middle"><i class="ti ti-device-desktop me-2"></i>سیستم</span>
				</a>
				</li>
				</ul>
				</li> *@
				<!-- / Style Switcher-->
				<!-- navbar button: Start -->
				<li>

					@{
						if (User.Identity.IsAuthenticated)

						{
						<li class="nav-item navbar-dropdown dropdown-user dropdown">
							<a class="nav-link dropdown-toggle hide-arrow" data-bs-toggle="dropdown" href="javascript:void(0);" aria-expanded="false">
								<span class="navbar-user-avatar">
								<i class="ti ti-user" style="color:#fff;font-size:1.1rem;"></i>
							</span>
							</a>
							<ul class="dropdown-menu dropdown-menu-end landing-nav-dropdown-menu">

								@if (User.HasClaim("Role", "Customer"))
								{
									<li>
										<a class="dropdown-item navbar-nav-btn" asp-area="AgencyArea" asp-controller="Customer" asp-action="MyTickets">
											<span><i class="ti ti-ticket"></i> سفرهای من</span>
										</a>
									</li>
									<li>
										<a class="dropdown-item navbar-nav-btn" asp-area="AgencyArea" asp-controller="Customer" asp-action="MyWallet">
											<span><i class="ti ti-wallet"></i> کیف پول</span>
										</a>
									</li>
								}
								else
								{
									<li>
										<a class="dropdown-item navbar-nav-btn" asp-area="AgencyArea" asp-controller="TicketInfo" asp-action="Index">
											<span><i class="ti ti-ticket"></i> سفرهای من</span>
										</a>
									</li>
								}

								<li class="landing-nav-dropdown-footer">
									<form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="w-100 m-0">
										@Html.AntiForgeryToken()
										<button type="submit" class="navbar-nav-btn navbar-nav-btn--danger w-100">
											<span><i class="ti ti-logout"></i> خروج از حساب</span>
										</button>
									</form>
								</li>
							</ul>
						</li>

						}

						else

						{
						<a asp-area="AgencyArea" asp-controller="Auth" asp-action="CustomerLogin" class="fw-medium btn btn-sm btn-primary navbar-nav-btn navbar-login-btn" aria-label="ورود / ثبت‌نام">
							<i class="ti ti-login" aria-hidden="true"></i>
							<span class="d-none d-md-inline navbar-login-label">ورود / ثبت‌نام</span>
						</a>
						}
					}
				</li>

				<!-- navbar button: End -->
			</ul>
		</div>
	</div>
</nav>
