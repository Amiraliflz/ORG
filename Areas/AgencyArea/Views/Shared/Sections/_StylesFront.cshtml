<!-- Local Persian fonts + subset icons (full Tabler font is ~700KB — not for public pages) -->
<environment include="Development">
  <link rel="stylesheet" href="~/vendor/fonts/tabler-icons-front.css" />

  <!-- Core CSS (RTL build — matches fa-IR UI without TemplateCustomizer) -->
  <link rel="stylesheet" href="~/vendor/css/rtl/core.css" class="template-customizer-core-css" />
  <link rel="stylesheet" href="~/vendor/css/rtl/theme-default.css" class="template-customizer-theme-css" />
  <link rel="stylesheet" href="~/vendor/libs/node-waves/node-waves.css" />

  <link rel="stylesheet" href="~/vendor/css/pages/front-page.css" />

  <!-- Application stylesheets -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/shadcn-bridge.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/front-palette.css" asp-append-version="true" />

</environment>

<environment exclude="Development">
  <link rel="preload" href="~/vendor/fonts/tabler-front/tabler-icons-front.woff2" as="font" type="font/woff2" crossorigin="anonymous" asp-append-version="true" />
  <link rel="preload" href="~/farsi-fonts/woff2/iransansx-medium.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="stylesheet" href="~/vendor/fonts/tabler-icons-front.css" asp-append-version="true" />

  <!-- Core CSS (RTL build — matches fa-IR UI without TemplateCustomizer) -->
  <link rel="stylesheet" href="~/vendor/css/rtl/core.css" class="template-customizer-core-css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/css/rtl/theme-default.css" class="template-customizer-theme-css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/node-waves/node-waves.css" asp-append-version="true" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="~/vendor/libs/node-waves/node-waves.css" asp-append-version="true" /></noscript>

  <link rel="stylesheet" href="~/vendor/css/pages/front-page.css" asp-append-version="true" />

  <!-- Application stylesheets -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/shadcn-bridge.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/front-palette.css" asp-append-version="true" />
</environment>
