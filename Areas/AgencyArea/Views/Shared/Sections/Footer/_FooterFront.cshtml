@using Application.Services.Seo
@{
  var path = Context.Request.Path.Value ?? "/";
  var shareUrl = ViewData["CanonicalUrl"] as string ?? SeoDefaults.BuildCanonical(path);
  var shareEnc = Uri.EscapeDataString(shareUrl);
  var shareText = Uri.EscapeDataString("مسترشوفر — رزرو سواری بین‌شهری و ترانسفر فرودگاهی");
}

<footer class="landing-footer bg-body footer-text">
  <div class="footer-top">
    <div class="container">
      <div class="row gx-0 gy-4 g-md-5">
        <div class="col-lg-5">
          <a asp-area="AgencyArea" asp-controller="Home" asp-action="Index" class="app-brand-link mb-4 d-inline-flex align-items-center">
            <img src="~/logo_full_b.png" height="36" width="160" alt="مسترشوفر" />
          </a>
          <p class="footer-text footer-logo-description mb-4">
            رزرو آنلاین تاکسی بین شهری، سواری دربستی و ترانسفر فرودگاهی با ناوگان تأییدشده و پشتیبانی ۲۴ ساعته.
          </p>
          <p class="footer-title mb-2">اشتراک‌گذاری این صفحه</p>
          <div class="d-flex flex-wrap gap-2 mb-3" id="pageShareBar">
            <a class="btn btn-sm btn-outline-primary"
               href="https://t.me/share/url?url=@shareEnc&amp;text=@shareText"
               target="_blank"
               rel="noopener noreferrer">تلگرام</a>
            <a class="btn btn-sm btn-outline-success"
               href="https://api.whatsapp.com/send?text=@(shareText)%20@(shareEnc)"
               target="_blank"
               rel="noopener noreferrer">واتساپ</a>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="copyPageLink" data-share-url="@shareUrl">کپی لینک</button>
            <button type="button" class="btn btn-sm btn-primary d-none" id="nativeShare" data-share-url="@shareUrl" data-share-title="مسترشوفر">اشتراک‌گذاری</button>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
          <p class="footer-title mb-4">خدمات</p>
          <ul class="list-unstyled">
            <li class="mb-3"><a href="/routes" class="footer-link">مسیرهای بین‌شهری</a></li>
            <li class="mb-3"><a href="/cities" class="footer-link">شهرهای تحت پوشش</a></li>
            <li class="mb-3"><a href="/#tripForm" class="footer-link">جستجوی سواری</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
          <p class="footer-title mb-4">پشتیبانی</p>
          <ul class="list-unstyled">
            <li class="mb-3"><a asp-area="AgencyArea" asp-controller="Home" asp-action="FAQ" class="footer-link">سوالات متداول</a></li>
            <li class="mb-3"><a asp-area="AgencyArea" asp-controller="Home" asp-action="ContactUs" class="footer-link">ارتباط با ما</a></li>
            <li class="mb-3"><a asp-area="AgencyArea" asp-controller="Home" asp-action="TravelPolicy" class="footer-link">قوانین سفر</a></li>
            <li class="mb-3"><a asp-area="AgencyArea" asp-controller="Home" asp-action="Privacy" class="footer-link">حریم خصوصی</a></li>
          </ul>
        </div>
        <div class="col-lg-3 col-md-4">
          <p class="footer-title mb-4">منابع</p>
          <ul class="list-unstyled">
            <li class="mb-3">
              <a class="footer-link" href="https://fa.wikipedia.org/wiki/%D8%AA%D8%A7%DA%A9%D8%B3%DB%8C_%D8%A7%DB%8C%D9%86%D8%AA%D8%B1%D9%86%D8%AA%DB%8C" target="_blank" rel="noopener noreferrer">تاکسی اینترنتی — ویکی‌پدیا</a>
            </li>
            <li class="mb-3">
              <a class="footer-link" href="https://www.mrud.ir/" target="_blank" rel="noopener noreferrer">وزارت راه و شهرسازی</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom py-3">
    <div class="container d-flex flex-wrap justify-content-between flex-md-row flex-column text-center text-md-start">
      <p class="footer-text mb-2 mb-md-0">© @DateTime.UtcNow.Year مسترشوفر. تمامی حقوق محفوظ است.</p>
      <p class="footer-text mb-0">
        <a class="footer-link" href="@SeoDefaults.PreferredOrigin/">mrshoofer.com</a>
      </p>
    </div>
  </div>
</footer>
<script>
(function () {
  var nativeBtn = document.getElementById('nativeShare');
  var copyBtn = document.getElementById('copyPageLink');
  if (nativeBtn && navigator.share) nativeBtn.classList.remove('d-none');
  if (nativeBtn) {
    nativeBtn.addEventListener('click', function () {
      navigator.share({
        title: nativeBtn.getAttribute('data-share-title') || document.title,
        url: nativeBtn.getAttribute('data-share-url') || window.location.href
      }).catch(function () {});
    });
  }
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      var url = copyBtn.getAttribute('data-share-url') || window.location.href;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () {
          copyBtn.textContent = 'کپی شد';
          setTimeout(function () { copyBtn.textContent = 'کپی لینک'; }, 1800);
        }).catch(function () {});
      }
    });
  }
})();
</script>
