@using Application.Services
@model DateTime;

<div class="card switchbar-container">


    <button class="scroll_button px-2" type="button" aria-label="روزهای بعدی">
        <i class="ti ti-chevron-right ti-b ti-md "></i>
    </button>


    <div class="timelline-container">


        @{
            DateTime selected_date = ViewBag.selecteddate;
            DateTime calendarToday = DateTime.Now.Date;
            string origin = ViewBag.origin_city_text as string ?? "";
            string dest = ViewBag.dest_city_text as string ?? "";
        }

        @for (int i = 0; i < 16; i++)
        {
            var day = calendarToday.AddDays(i);
            var dayP = new PersianDate(day);
            var dateString = dayP.Year + "-" + dayP.Month + "-" + dayP.Day;
            var searchstring = $"/TaxiTrips?originstring={Uri.EscapeDataString(origin)}&destinationstring={Uri.EscapeDataString(dest)}&searchdate={dateString}";
            var isSelected = day.Date == selected_date.Date;

            <div class="tripday mt-1 @(isSelected ? "badge bg-label-secondary rounded-pill" : "")">
                <a href="@searchstring" class="text-body text-decoration-none d-block">
                    <p class="mb-1 daytext mt-1">
                        @dayP.DayOfWeek  @dayP.Month/@dayP.Day
                    </p>

                    <div class="daypriceconainer">
                        <p class="dayprice mb-1">
                            <img src="/available_route.png" width="35" height="35" alt="" loading="lazy" decoding="async" />
                        </p>
                    </div>
                    @if (isSelected)
                    {
                        <span class="selected-dayspan"></span>
                    }
                </a>
            </div>
        }
    </div>


    <button class="scroll_button px-2" type="button" aria-label="روزهای قبلی">
        <i class="ti ti-chevron-left ti-md"></i>
    </button>

</div>
