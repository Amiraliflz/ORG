@using Application.Services.Seo
@{
    var content = ViewBag.RouteSeo as RouteContent.Bundle;
    var route = ViewBag.RoutePage as RouteCatalog.RoutePage;
    var related = ViewBag.RelatedRoutes as IReadOnlyList<RouteCatalog.RoutePage>
        ?? Array.Empty<RouteCatalog.RoutePage>();
    var reverse = ViewBag.ReverseRoute as RouteCatalog.RoutePage;
}
@if (content is null || route is null) { return; }

<section class="route-seo-bottom" id="route-seo" dir="rtl" style="scroll-margin-top: 5.5rem;">

                <div class="card route-seo-card shadow-none">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-label-primary rounded-pill">راهنمای مسیر</span>
                        </div>
                        <h1 class="route-seo-h1">@content.H1</h1>
                        <p class="route-seo-lead mb-0">@content.Intro</p>
                        @{
                            var hasTime = route.TravelTimeMins is int;
                            var hasKm = content.ApproxKm is int;
                        }
                        @if (hasTime || hasKm)
                        {
                            <ul class="route-seo-facts">
                                @if (route.TravelTimeMins is int mins)
                                {
                                    <li class="route-seo-fact">
                                        <span class="route-seo-fact-label">زمان تقریبی</span>
                                        <span class="route-seo-fact-value">@(mins >= 60 ? $"{mins / 60} ساعت{(mins % 60 > 0 ? $" و {mins % 60} دقیقه" : "")}" : $"{mins} دقیقه")</span>
                                    </li>
                                }
                                @if (content.ApproxKm is int km)
                                {
                                    <li class="route-seo-fact">
                                        <span class="route-seo-fact-label">مسافت تقریبی</span>
                                        <span class="route-seo-fact-value">@km کیلومتر</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="route-seo-fact-fallback mb-0">قیمت پس از جستجو مشخص می‌شود · پشتیبانی ۲۴/۷</p>
                        }
                    </div>
                </div>

                <div class="card route-seo-card shadow-none mt-3">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="route-seo-h2 mt-0">درباره مسیر @route.OriginFa به @route.DestinationFa</h2>
                        <div class="route-seo-blocks">
                            @foreach (var block in content.AboutBlocks)
                            {
                                <div class="route-seo-block">
                                    <strong class="route-seo-block-label">@block.Label</strong>
                                    <p class="route-seo-p mb-0">@block.Text</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card route-seo-card shadow-none mt-3">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="route-seo-h2 mt-0">زمان، مسافت و برنامه‌ریزی</h2>
                        <p class="route-seo-p mb-0">@content.TravelInfo</p>
                    </div>
                </div>

                <div class="card route-seo-card shadow-none mt-3">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="route-seo-h2 mt-0">@content.TipsHeading</h2>
                        <ul class="route-seo-list mb-0">
                            @foreach (var tip in content.Tips)
                            {
                                <li>@tip</li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="card route-seo-card shadow-none mt-3">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="route-seo-h2 mt-0">@content.HowToHeading</h2>
                        <div class="row g-2">
                            @for (var i = 0; i < content.HowToSteps.Count; i++)
                            {
                                var step = content.HowToSteps[i];
                                <div class="col-md-6">
                                    <div class="route-seo-step">
                                        <span class="route-seo-step-num">@(i + 1)</span>
                                        <div>
                                            <strong>@step.Title</strong>
                                            <p class="mb-0">@step.Text</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card route-seo-card shadow-none mt-3">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="route-seo-h2 mt-0">@content.WhyHeading</h2>
                        <p class="route-seo-p mb-0">@content.WhyBody</p>
                    </div>
                </div>

                <div class="card route-seo-card shadow-none mt-3">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="route-seo-h2 mt-0">سوالات پرتکرار</h2>
                        <div class="accordion route-seo-faq" id="routeSeoFaq">
                            @for (var i = 0; i < content.Faqs.Count; i++)
                            {
                                var faq = content.Faqs[i];
                                var id = $"rsf{i + 1}";
                                <div class="accordion-item">
                                    <h3 class="accordion-header">
                                        <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#@id"
                                                aria-expanded="@(i == 0 ? "true" : "false")">
                                            @faq.Question
                                        </button>
                                    </h3>
                                    <div id="@id" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#routeSeoFaq">
                                        <div class="accordion-body">@faq.Answer</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card route-seo-card shadow-none mt-3 mb-0">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="route-seo-h2 mt-0">مسیرهای مرتبط</h2>
                        <div class="d-flex flex-wrap gap-2">
                            @if (reverse is not null)
                            {
                                <a class="btn btn-sm btn-outline-primary rounded-pill" href="/routes/@reverse.Slug">
                                    برگشت: @reverse.OriginFa ← @reverse.DestinationFa
                                </a>
                            }
                            @foreach (var r in related.Take(6))
                            {
                                <a class="btn btn-sm btn-outline-secondary rounded-pill" href="/routes/@r.Slug">
                                    @r.OriginFa ← @r.DestinationFa
                                </a>
                            }
                            <a class="btn btn-sm btn-label-primary rounded-pill" href="/routes">همه مسیرها</a>
                            <a class="btn btn-sm btn-label-secondary rounded-pill" href="/cities">شهرها</a>
                        </div>
                    </div>
                </div>

</section>
