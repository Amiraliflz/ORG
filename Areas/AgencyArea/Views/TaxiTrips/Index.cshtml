@section PageScripts {
    <script src="~/js/cards-actions.js"></script>
    <script src="~/js/front-page-landing.js"></script>
    @* Do not load IndexPage.js here — it remaps window.Date and reinits #starttime without preserving value. *@
    <script>
      (function () {
        var el = document.querySelector('#starttime');
        if (!el || typeof flatpickr !== 'function') return;
        var existing = (el.value || '').trim();
        flatpickr(el, {
          disableMobile: true,
          monthSelectorType: 'static',
          defaultDate: existing || 'today',
          minDate: 'today',
          altFormat: 'Y/m/d',
          dateFormat: 'Y/m/d',
          locale: Object.assign({}, (window.flatpickr && flatpickr.l10ns && flatpickr.l10ns.fa) || {}, {
            weekdays: {
              shorthand: ["شنبه", "یکشنبه", "د", "س", "چ", "پ", "ج"],
              longhand: ["شنبه", "یک‌شنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنج‌شنبه", "جمعه"]
            },
            daysInMonth: [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 29],
            firstDayOfWeek: 6
          })
        });
      })();
    </script>
    <script src="~/js/searchpage.js?v=5"></script>
    <script src="~/js/Trips.js?v=7"></script>
}


