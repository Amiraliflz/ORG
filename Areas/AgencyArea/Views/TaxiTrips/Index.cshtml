@model List<Application.Services.MrShooferORS.SearchedTrip>
@using Application.Services.Seo

@{

    Layout = "_FrontLayout";

    var isSeoLanding = ViewBag.IsSeoRouteLanding is bool seoFlag && seoFlag;
    var hasSeoContent = ViewBag.RouteSeo is RouteContent.Bundle;
    var routePage = ViewBag.RoutePage as RouteCatalog.RoutePage;
    var routeContent = ViewBag.RouteSeo as RouteContent.Bundle;

    if (isSeoLanding && routePage is not null && routeContent is not null)
    {
        ViewData["Title"] = ViewData["Title"] as string ?? RouteCatalog.Title(routePage);
        ViewData["MetaDescription"] = ViewData["MetaDescription"] as string ?? routeContent.MetaDescription;
        ViewData["OgTitle"] = ViewData["OgTitle"] as string
            ?? SeoDefaults.BuildOgTitle(ViewData["Title"] as string);
        ViewData["OgDescription"] = ViewData["OgDescription"] as string
            ?? ViewData["MetaDescription"] as string;
        ViewData["OgImage"] = ViewData["OgImage"] as string ?? SeoDefaults.DefaultOgImageUrl;
        ViewData["OgImageAlt"] = ViewData["OgImageAlt"] as string
            ?? SeoDefaults.BuildRouteOgAlt(routePage.OriginFa, routePage.DestinationFa);
        ViewData["CanonicalUrl"] = ViewData["CanonicalUrl"] as string
            ?? SeoDefaults.BuildCanonical($"/routes/{routePage.Slug}");
        ViewData["Robots"] = ViewData["Robots"] as string
            ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
    }
    else
    {
        // Ephemeral search results (querystring dates change daily) — keep out of the index.
        ViewData["Title"] = ViewData["Title"] as string
            ?? (routePage is not null ? RouteCatalog.Title(routePage) : "جستجوی سواری");
        ViewData["MetaDescription"] = ViewData["MetaDescription"] as string
            ?? routeContent?.MetaDescription
            ?? "نتایج جستجوی سواری بین‌شهری مسترشوفر بر اساس مبدأ، مقصد و تاریخ انتخابی شما.";
        ViewData["Robots"] = "noindex, follow";
        if (routePage is not null)
        {
            ViewData["CanonicalUrl"] = SeoDefaults.BuildCanonical($"/routes/{routePage.Slug}");
            // Still set share tags so messengers get the right title/description when a link is copied.
            ViewData["OgTitle"] = SeoDefaults.BuildOgTitle(RouteCatalog.Title(routePage));
            ViewData["OgDescription"] = routeContent?.MetaDescription ?? (string)ViewData["MetaDescription"]!;
            ViewData["OgImage"] = SeoDefaults.DefaultOgImageUrl;
            ViewData["OgImageAlt"] = SeoDefaults.BuildRouteOgAlt(routePage.OriginFa, routePage.DestinationFa);
        }
    }
}




