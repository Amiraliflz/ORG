	/* Single shared page gradient — children stay transparent */
	.trips-page-shell {
		background-color: hsla(213.08823529411762, 0%, 93%, 1);
		background-image:
			radial-gradient(circle at 83% 22%, hsla(35.735294117647136, 82%, 87%, 1) 0%, transparent 50%),
			radial-gradient(circle at 0% 50%, hsla(194.5588235294118, 37%, 91%, 1) 0%, transparent 50%),
			radial-gradient(circle at 21% 21%, hsla(27.999999999999577, 0%, 86%, 1) 0%, transparent 50%),
			radial-gradient(circle at 54% 77%, hsla(193.2352941176474, 100%, 95%, 1) 0%, transparent 50%),
			radial-gradient(circle at 30% 75%, hsla(197.87234042553195, 25%, 35%, 1) 0%, transparent 20%);
		background-blend-mode: normal, normal, normal, normal, normal;
		background-attachment: scroll;
		min-height: 100vh;
	}

	.trips-page-shell .landing-hero,
	.trips-page-shell .trips-results,
	.trips-page-shell .page-bottom-shell {
		background: transparent !important;
		background-image: none !important;
		border-radius: 0 !important;
		margin-inline: 0 !important;
	}

	.trips-page-shell .landing-hero::before,
	.trips-page-shell .landing-hero::after {
		display: none !important;
		content: none !important;
	}
</style>


