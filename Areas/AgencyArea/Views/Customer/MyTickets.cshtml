@using Application.Models
@model IEnumerable<Ticket>
@{
    Layout = "_AgencySideLayout";
    ViewData["title"] = "سفرهای من";
    decimal balance = ViewBag.Balance ?? 0m;
    var phone = (string)(ViewBag.CustomerPhone ?? "");
    var successMsg = TempData["Success"] as string;
    var errorMsg = TempData["Error"] as string;

    bool CanCancel(Ticket t)
    {
        if (t.IsCancelled) return false;
        var code = t.TicketCode ?? "";
        if (string.IsNullOrWhiteSpace(code)) return false;
        if (code.StartsWith("PENDING-", StringComparison.OrdinalIgnoreCase)) return false;
        if (code.StartsWith("PAID-NO-RESERVE-", StringComparison.OrdinalIgnoreCase)) return false;
        return true;
    }

    var ticketsJson = System.Text.Json.JsonSerializer.Serialize(Model.Select(t => new {
        id           = t.Id,
        origin       = t.TripOrigin      ?? "",
        destination  = t.TripDestination ?? "",
        firstName    = t.Firstname        ?? "",
        lastName     = t.Lastname         ?? "",
        registeredFa = t.RegisteredAt.ToString("yyyy/MM/dd"),
        price        = t.TicketFinalPrice,
        ticketCode   = t.TicketCode      ?? "",
        paymentRef   = t.PaymentRefId    ?? "",
        carName      = t.CarName         ?? "",
        serviceName  = t.ServiceName     ?? "",
        isCancelled  = t.IsCancelled,
        isWallet     = t.PaymentRefId == "WALLET",
        canCancel    = CanCancel(t),
        cancelReason = t.CancelReason    ?? ""
    }));
}

@section VendorScripts {
    <script src="https://unpkg.com/vue@@3/dist/vue.global.prod.js"></script>
}

<style>
.tickets-hero{background:#fff;border-radius:1.25rem;padding:1rem 1.25rem;position:relative;overflow:hidden;border:1.5px solid #e5e5e5;box-shadow:0 2px 12px rgba(0,0,0,.07)}
.tickets-hero::after{content:'';position:absolute;inset:0;border:1px solid rgba(0,0,0,.08);border-radius:1.25rem;pointer-events:none}
.ghost-btn{background:#f3f3f3;color:#000000;border:none;border-radius:2rem;padding:.3rem .9rem;font-size:.82rem;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem;font-weight:500;transition:all .18s;white-space:nowrap;box-shadow:0 1px 6px rgba(0,0,0,.1)}
.ghost-btn:hover{background:#f3f3f3;color:#000000}
.search-wrap{background:#fff;border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,.07);padding:1rem 1.25rem}
.ftab{border-radius:2rem;padding:.32rem 1rem;font-size:.83rem;border:1.5px solid #e5e5e5;cursor:pointer;transition:all .18s;background:transparent;color:#6e6b7b;white-space:nowrap;flex-shrink:0}
.ftab.active,.ftab:hover{background:#000000;border-color:#000000;color:#fff}
.filter-scroll{display:flex;gap:.5rem;overflow-x:auto;padding-bottom:2px;-webkit-overflow-scrolling:touch}
.filter-scroll::-webkit-scrollbar{display:none}
.tcard{border-radius:1rem;border:none;box-shadow:0 2px 12px rgba(0,0,0,.07);overflow:hidden;background:#fff;transition:all .22s}
.tcard:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(0,0,0,.12)}
.troute{background:linear-gradient(135deg,#f3f3f3 0%,#f6f6f6 100%);padding:.9rem 1.1rem;border-bottom:1px solid #e5e5e5}
.rdot{width:8px;height:8px;border-radius:50%;background:#000000;flex-shrink:0}
.rline{flex:1;height:1px;background:repeating-linear-gradient(90deg,#000000 0,#000000 4px,transparent 4px,transparent 10px);margin:0 6px;min-width:20px}
.tbody{padding:.85rem 1.1rem 1rem}
.mchip{background:#f5f5f9;border-radius:2rem;padding:.18rem .7rem;font-size:.77rem;color:#6e6b7b;display:inline-flex;align-items:center;gap:.25rem}
.wbadge{background:#eafbf0;color:#28c76f;border-radius:2rem;padding:.18rem .7rem;font-size:.75rem}
.rbadge{background:#f3f3f3;color:#000000;border-radius:2rem;padding:.18rem .7rem;font-size:.75rem;direction:ltr;word-break:break-all}
.empty-box{text-align:center;padding:3rem 1rem}
.empty-icon{width:88px;height:88px;background:#f3f3f3;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.1rem;font-size:2.2rem;color:#000000}
.cancel-policy{background:#fff8f0;border:1px solid #ffe0b8;border-radius:.75rem;padding:.75rem .9rem;font-size:.8rem;color:#6e6b7b;line-height:1.7}
.cancel-policy ul{margin:0;padding-right:1.1rem}
.t-toast{position:fixed;top:1.3rem;left:50%;transform:translateX(-50%) translateY(calc(-100% - 2rem));z-index:9999;min-width:280px;max-width:90vw;border-radius:1rem;padding:.75rem 1.2rem;display:flex;align-items:flex-start;gap:.6rem;font-size:.88rem;font-weight:500;transition:transform .38s cubic-bezier(.34,1.56,.64,1);pointer-events:none}
.t-toast.show{transform:translateX(-50%) translateY(0);pointer-events:auto}
.t-toast-success{background:#28c76f;color:#fff;box-shadow:0 4px 20px rgba(40,199,111,.28)}
.t-toast-error{background:#ff4c51;color:#fff;box-shadow:0 4px 20px rgba(255,76,81,.28)}
.t-toast-close{background:none;border:none;color:#fff;opacity:.75;cursor:pointer;padding:0;margin-right:auto;font-size:1rem;line-height:1;flex-shrink:0}

/* ── Mobile ── */
@@media(max-width:575.98px){
  .tickets-hero{padding:.85rem 1rem;border-radius:1rem}
  .tickets-hero h4{font-size:1.05rem;margin-bottom:.2rem}
  .hero-actions{flex-direction:column;gap:.4rem!important;align-items:flex-end}
  .ghost-btn{padding:.25rem .7rem;font-size:.76rem}
  .ghost-btn .btn-label{display:none}
  .search-wrap{padding:.75rem 1rem}
  .troute .fw-bold{font-size:.9rem}
  .troute .rdot{width:7px;height:7px}
  .mchip{font-size:.72rem}
}
</style>

@if (!string.IsNullOrEmpty(successMsg))
{
    <div id="tt-ok" class="t-toast t-toast-success">
        <i class="ti ti-circle-check" style="font-size:1.2rem;flex-shrink:0;margin-top:.1rem"></i>
        <span style="flex:1">@successMsg</span>
        <button class="t-toast-close" onclick="this.closest('.t-toast').classList.remove('show')" aria-label="بستن">
            <i class="ti ti-x"></i>
        </button>
    </div>
}
@if (!string.IsNullOrEmpty(errorMsg))
{
    <div id="tt-err" class="t-toast t-toast-error">
        <i class="ti ti-alert-circle" style="font-size:1.2rem;flex-shrink:0;margin-top:.1rem"></i>
        <span style="flex:1">@errorMsg</span>
        <button class="t-toast-close" onclick="this.closest('.t-toast').classList.remove('show')" aria-label="بستن">
            <i class="ti ti-x"></i>
        </button>
    </div>
}

<!-- ── Tickets App ── -->
<div id="ticketsApp">

    <!-- Hero -->
    <div class="tickets-hero mb-4">
        <div class="d-flex justify-content-between align-items-center position-relative" style="z-index:1">
            <div class="me-2 min-w-0">
                <h4 class="fw-bold mb-1" style="color:#29263d"><i class="ti ti-ticket me-2" style="color:#000000"></i>سفرهای من</h4>
                <p class="mb-0 text-muted" style="font-size:.88rem" id="heroCount">
                    @Model.Count() سفر ثبت‌شده
                </p>
            </div>
            <div class="d-flex gap-2 hero-actions flex-shrink-0">
                <a href="/Customer/MyWallet" class="ghost-btn">
                    <i class="ti ti-wallet"></i><span class="btn-label">@balance.ToString("N0") تومان</span>
                </a>
                <a href="/" class="ghost-btn">
                    <i class="ti ti-plus"></i><span class="btn-label">سفر جدید</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Search + filter bar -->
    <div class="search-wrap mb-4">
        <div class="input-group mb-3">
            <span class="input-group-text bg-transparent border-0 pe-0">
                <i class="ti ti-search text-muted"></i>
            </span>
            <input id="searchInput" type="text" class="form-control border-0 ps-1"
                   placeholder="جستجو: مسیر، نام مسافر، کد بلیط..."
                   style="box-shadow:none" oninput="applyFilters()" />
        </div>
        <div class="filter-scroll" id="filterTabs">
            <button class="ftab active" onclick="setFilter('all',this)">
                همه (<span id="cntAll">@Model.Count()</span>)
            </button>
            <button class="ftab" onclick="setFilter('active',this)">
                <i class="ti ti-circle-check me-1"></i>فعال (<span id="cntActive">@Model.Count(t => !t.IsCancelled)</span>)
            </button>
            <button class="ftab" onclick="setFilter('cancelled',this)">
                <i class="ti ti-circle-x me-1"></i>لغو شده (<span id="cntCancelled">@Model.Count(t => t.IsCancelled)</span>)
            </button>
        </div>
    </div>

    <!-- Ticket list -->
    <div id="ticketList" class="row g-3"></div>

    <!-- Empty state -->
    <div id="emptyState" class="empty-box" style="display:none">
        <div class="empty-icon"><i class="ti ti-ticket-off"></i></div>
        <h5 class="text-muted fw-semibold mb-2" id="emptyTitle">نتیجه‌ای یافت نشد</h5>
        <p class="text-muted" id="emptyText">فیلتر یا جستجو را تغییر دهید</p>
        <a id="emptyAction" href="/" class="btn btn-primary mt-1 rounded-pill px-4" style="display:none">
            <i class="ti ti-search me-1"></i> جستجوی سفر
        </a>
    </div>

</div>

<!-- Cancel modal -->
<div class="modal fade" id="cancelTicketModal" tabindex="-1" aria-labelledby="cancelTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:1rem;border:none">
            <form method="post" asp-area="AgencyArea" asp-controller="Customer" asp-action="CancelTicket" id="cancelTicketForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ticketId" id="cancelTicketId" value="" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="cancelTicketModalLabel">لغو بلیط</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-2" style="font-size:.88rem">
                        مسیر: <strong id="cancelRouteLabel"></strong>
                        <br />کد بلیط: <span id="cancelCodeLabel" class="font-monospace" dir="ltr"></span>
                    </p>
                    <div class="cancel-policy mb-3">
                        <div class="fw-semibold mb-1" style="color:#29263d"><i class="ti ti-info-circle me-1"></i>شرایط کنسلی</div>
                        <ul>
                            <li>تا ۱ ساعت پس از خرید: بدون جریمه</li>
                            <li>بیش از ۱۲ ساعت تا سفر: ۲۰٪ جریمه</li>
                            <li>بین ۳ تا ۱۲ ساعت تا سفر: ۵۰٪ جریمه</li>
                        </ul>
                        <div class="mt-1">مبلغ بازگشتی پس از لغو به کیف پول شما واریز می‌شود.</div>
                    </div>
                    <label for="cancelReason" class="form-label fw-semibold">دلیل لغو <span class="text-danger">*</span></label>
                    <textarea id="cancelReason" name="reason" class="form-control" rows="3" maxlength="500"
                              placeholder="لطفاً دلیل لغو بلیط را بنویسید..." required></textarea>
                    <div class="form-text">حداقل ۳ کاراکتر — حداکثر ۵۰۰ کاراکتر</div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-label-secondary rounded-pill" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger rounded-pill" id="cancelSubmitBtn">
                        <i class="ti ti-x me-1"></i>تأیید لغو بلیط
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Inline script — runs after DOM is rendered -->
<script>
(function () {
    const ALL = @Html.Raw(ticketsJson);
    let currentFilter = 'all';

    function fmt(n) { return Number(n).toLocaleString('en-US'); }

    function esc(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function buildCard(t) {
        const statusBadge = t.isCancelled
            ? '<span class="badge bg-label-danger rounded-pill px-3 py-1">لغو شده</span>'
            : '<span class="badge bg-label-success rounded-pill px-3 py-1">فعال</span>';

        const carChip  = t.carName     ? `<span class="mchip"><i class="ti ti-car"></i>${esc(t.carName)}</span>` : '';
        const svcChip  = t.serviceName ? `<span class="mchip"><i class="ti ti-building"></i>${esc(t.serviceName)}</span>` : '';

        let payBadge = '';
        if (t.isWallet) payBadge = '<span class="wbadge"><i class="ti ti-wallet me-1"></i>کیف پول</span>';
        else if (t.paymentRef) payBadge = `<span class="rbadge">شناسه پرداخت: ${esc(t.paymentRef)}</span>`;

        const cancelBtn = t.canCancel
            ? `<button type="button" class="btn btn-sm btn-label-danger rounded-pill"
                       onclick="openCancelModal(${t.id})" title="لغو بلیط">
                 <i class="ti ti-x"></i> لغو
               </button>`
            : '';

        const reasonNote = (t.isCancelled && t.cancelReason)
            ? `<div class="text-muted mt-2" style="font-size:.78rem"><i class="ti ti-message me-1"></i>دلیل لغو: ${esc(t.cancelReason)}</div>`
            : '';

        return `
        <div class="col-12 col-lg-6">
          <div class="tcard">
            <div class="troute">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2 fw-bold" style="font-size:1rem">
                  <span>${esc(t.origin)}</span>
                  <div class="d-flex align-items-center" style="flex:1;min-width:55px">
                    <div class="rdot"></div>
                    <div class="rline"></div>
                    <i class="ti ti-car text-primary" style="font-size:.9rem"></i>
                  </div>
                  <span>${esc(t.destination)}</span>
                </div>
                ${statusBadge}
              </div>
              <div class="text-muted" style="font-size:.8rem">
                <i class="ti ti-calendar-event me-1"></i>${esc(t.registeredFa)}
              </div>
            </div>
            <div class="tbody">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <div class="fw-semibold mb-1">${esc(t.firstName)} ${esc(t.lastName)}</div>
                  <div class="d-flex flex-wrap gap-1">${carChip}${svcChip}</div>
                </div>
                <div class="text-end">
                  <div class="fw-bold text-primary" style="font-size:1rem">${fmt(t.price)}</div>
                  <small class="text-muted">تومان</small>
                </div>
              </div>
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex flex-wrap gap-2">
                  <span class="mchip"><i class="ti ti-hash"></i>${esc(t.ticketCode)}</span>
                  ${payBadge}
                </div>
                <div class="d-flex gap-1">
                  ${cancelBtn}
                  <a href="/TripReceiptPdf?reference=${encodeURIComponent(t.ticketCode)}" target="_blank"
                     class="btn btn-sm btn-icon btn-label-primary rounded-pill" title="چاپ بلیط">
                    <i class="ti ti-printer"></i>
                  </a>
                </div>
              </div>
              ${reasonNote}
            </div>
          </div>
        </div>`;
    }

    function applyFilters() {
        const q = (document.getElementById('searchInput')?.value || '').trim().toLowerCase();
        let list = ALL;

        if (currentFilter === 'active')    list = list.filter(t => !t.isCancelled);
        if (currentFilter === 'cancelled') list = list.filter(t =>  t.isCancelled);

        if (q) {
            list = list.filter(t =>
                t.origin.toLowerCase().includes(q) ||
                t.destination.toLowerCase().includes(q) ||
                t.firstName.toLowerCase().includes(q) ||
                t.lastName.toLowerCase().includes(q) ||
                t.ticketCode.toLowerCase().includes(q)
            );
        }

        const container = document.getElementById('ticketList');
        const empty     = document.getElementById('emptyState');
        const heroCount = document.getElementById('heroCount');

        if (list.length === 0) {
            container.innerHTML = '';
            empty.style.display = '';
            const noTicketsAtAll = ALL.length === 0;
            document.getElementById('emptyTitle').textContent = noTicketsAtAll ? 'هنوز بلیطی خریداری نکرده‌اید' : 'نتیجه‌ای یافت نشد';
            document.getElementById('emptyText').textContent  = noTicketsAtAll ? 'با کلیک روی سفر جدید اولین سفر خود را رزرو کنید' : 'فیلتر یا جستجو را تغییر دهید';
            document.getElementById('emptyAction').style.display = noTicketsAtAll ? '' : 'none';
        } else {
            empty.style.display = 'none';
            container.innerHTML = list.map(buildCard).join('');
        }

        if (heroCount) heroCount.textContent = list.length + ' سفر' + (q || currentFilter !== 'all' ? ' (فیلتر شده)' : ' ثبت‌شده');
    }

    window.setFilter = function (f, btn) {
        currentFilter = f;
        document.querySelectorAll('.ftab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilters();
    };

    window.applyFilters = applyFilters;

    window.openCancelModal = function (ticketId) {
        const t = ALL.find(x => x.id === ticketId);
        if (!t || !t.canCancel) return;
        document.getElementById('cancelTicketId').value = String(t.id);
        document.getElementById('cancelRouteLabel').textContent = t.origin + ' ← ' + t.destination;
        document.getElementById('cancelCodeLabel').textContent = t.ticketCode;
        document.getElementById('cancelReason').value = '';
        const modalEl = document.getElementById('cancelTicketModal');
        if (window.bootstrap && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        } else {
            modalEl.classList.add('show');
            modalEl.style.display = 'block';
        }
    };

    const form = document.getElementById('cancelTicketForm');
    if (form) {
        form.addEventListener('submit', function (e) {
            const btn = document.getElementById('cancelSubmitBtn');
            const reason = (document.getElementById('cancelReason')?.value || '').trim();
            if (reason.length < 3) {
                e.preventDefault();
                return;
            }
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>در حال لغو...';
            }
        });
    }

    // Toasts
    ['tt-ok', 'tt-err'].forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        requestAnimationFrame(function () { el.classList.add('show'); });
        setTimeout(function () { el.classList.remove('show'); }, 6000);
    });

    // Initial render
    applyFilters();
})();
</script>
