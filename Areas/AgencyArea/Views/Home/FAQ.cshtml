@{
    Layout = "_AgencySideLayout";
    ViewData["UseFullTabler"] = false;
    ViewData["Title"] = "سوالات متداول";
    ViewData["MetaDescription"] = "پاسخ سوالات پرتکرار درباره رزرو سواری بین‌شهری، بلیط، کلاس سفر، ترانسفر فرودگاهی و پشتیبانی مسترشوفر.";
    ViewData["CanonicalUrl"] = SeoDefaults.BuildCanonical("/Home/FAQ");
    ViewData["RouteFaqs"] = SeoDefaults.FaqPageItems();
    ViewData["DateModified"] = "2026-08-14";
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
      ("صفحه اصلی", SeoDefaults.BuildCanonical("/")),
      ("سوالات متداول", SeoDefaults.BuildCanonical("/Home/FAQ"))
    };
}

<style>
    .faq-hero {
        background: linear-gradient(135deg, #111111 0%, #2a2a2a 100%);
        border-radius: 1.5rem;
        color: #fff;
        padding: 2.5rem 2rem;
        margin-bottom: 2rem;
    }
    .faq-accordion .accordion-button {
        font-family: font-demi-bold, "tahoma", sans-serif;
        font-weight: normal;
        font-size: .95rem;
        color: #444;
        background: #fff;
        border-radius: .75rem !important;
        box-shadow: none !important;
        line-height: 1.6;
        letter-spacing: 0;
    }
    .faq-accordion .accordion-button:not(.collapsed) {
        color: #000000;
        background: #f4f4ff;
    }
    .faq-accordion .accordion-button::after {
        margin-right: auto;
        margin-left: 0;
    }
    .faq-accordion .accordion-item {
        border: 1.5px solid #e8e8f0;
        border-radius: .75rem !important;
        margin-bottom: .75rem;
        overflow: hidden;
    }
    .faq-accordion .accordion-body {
        color: #555;
        line-height: 1.85;
        font-size: .9rem;
        letter-spacing: 0;
    }
    .faq-section-title {
        font-family: font-bold, "tahoma", sans-serif;
        font-size: 1rem;
        font-weight: normal;
        color: #000000;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
        line-height: 1.5;
        letter-spacing: 0;
    }
</style>

<div class="container py-4" style="max-width:860px">

    <div class="faq-hero text-center">
        <i class="ti ti-help-circle" style="font-size:2.5rem;margin-bottom:.5rem;display:block"></i>
        <h1 class="fw-bold mb-1 h4">سوالات متداول</h1>
        <p class="mb-0 opacity-75" style="font-size:.9rem;line-height:1.8">پاسخ سوال‌های رایج درباره خرید بلیط، کنسلی، پرداخت و ترانسفر فرودگاهی</p>
    </div>

    @{
        var faqGroups = SeoDefaults.FaqPageSections;
        for (var s = 0; s < faqGroups.Length; s++)
        {
            var group = faqGroups[s];
            var accordionId = $"faqSection{s}";
            <h2 class="faq-section-title">@group.Heading</h2>
            <div class="accordion faq-accordion mb-4" id="@accordionId">
                @for (var i = 0; i < group.Items.Length; i++)
                {
                    var item = group.Items[i];
                    var collapseId = $"faq{s}_{i}";
                    var isFirst = s == 0 && i == 0;
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button @(isFirst ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isFirst ? "true" : "false")">
                                @item.Question
                            </button>
                        </h3>
                        <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")" data-bs-parent="#@accordionId">
                            <div class="accordion-body">
                                @item.Answer
                                @if (item.Question.Contains("کنسل"))
                                {
                                    <p class="mb-0 mt-2">
                                        <a asp-area="AgencyArea" asp-controller="Home" asp-action="TravelPolicy">مشاهده جدول قوانین کنسلی</a>
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <div class="card rounded-4 p-4 text-center" style="background:#f4f4ff;border:1.5px solid #dcdcff">
        <i class="ti ti-headset" style="font-size:2rem;color:#000;margin-bottom:.5rem;display:block"></i>
        <p class="fw-bold mb-1">سوالتان اینجا نبود؟</p>
        <p class="text-muted mb-3" style="font-size:.88rem;line-height:1.8">تیم پشتیبانی ۲۴ ساعته آماده پاسخگویی است</p>
        <a asp-controller="Home" asp-action="ContactUs" class="btn btn-primary rounded-pill px-4">ارتباط با ما</a>
    </div>

</div>
