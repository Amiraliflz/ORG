@{
    Layout = "_FrontLayout";
    ViewData["UseFullTabler"] = false;
    ViewData["Title"] = "حریم شخصی";
    ViewData["MetaDescription"] = "سیاست حریم شخصی مسترشوفر — نحوه جمع‌آوری، نگهداری و استفاده از اطلاعات کاربران در سامانه رزرو سواری بین‌شهری.";
    ViewData["CanonicalUrl"] = SeoDefaults.BuildCanonical("/Home/Privacy");
    ViewData["Robots"] = "index, follow";
    ViewData["DateModified"] = "2026-08-14";
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
      ("صفحه اصلی", SeoDefaults.BuildCanonical("/")),
      ("حریم شخصی", SeoDefaults.BuildCanonical("/Home/Privacy"))
    };
}

@section PageStyles {
    <link href="~/css/RoutePages.css?v=19" rel="stylesheet" />
}

<section class="section-py route-hub legal-page">
    <div class="container" style="max-width: 46rem">
        <nav class="route-breadcrumbs" aria-label="breadcrumb">
            <ol>
                <li><a href="/">صفحه اصلی</a></li>
                <li aria-current="page">حریم شخصی</li>
            </ol>
        </nav>

        <header class="route-hub-header">
            <h1 class="route-hub-title">حریم شخصی</h1>
            <p class="route-hub-lead">
                سیاست حفظ حریم خصوصی کاربران مسترشوفر — چه اطلاعاتی جمع می‌شود، چگونه استفاده می‌شود و چه حقوقی دارید.
            </p>
        </header>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">مقدمه</h2>
            <p>
                مسترشوفر به حفظ حریم خصوصی شما متعهد است. این صفحه توضیح می‌دهد چه اطلاعاتی هنگام استفاده از
                سامانه رزرو سواری بین‌شهری جمع‌آوری می‌شود، چگونه استفاده می‌شود و چه حقوقی دارید.
                با استفاده از خدمات ما، این سیاست را می‌پذیرید.
            </p>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">اطلاعاتی که جمع‌آوری می‌کنیم</h2>
            <ul>
                <li>اطلاعات هویتی و تماس مسافر: نام، نام خانوادگی، شماره موبایل، کد ملی و در صورت نیاز تاریخ تولد.</li>
                <li>اطلاعات سفر: مبدأ، مقصد، تاریخ/ساعت سفر و جزئیات بلیط.</li>
                <li>اطلاعات پرداخت: نتیجه تراکنش و شناسه پرداخت (جزئیات کارت بانکی نزد درگاه پرداخت نگهداری می‌شود).</li>
                <li>اطلاعات فنی حداقلی برای امنیت و بهبود سرویس: مانند نشانی IP، نوع مرورگر و زمان درخواست.</li>
            </ul>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">نحوه استفاده از اطلاعات</h2>
            <ul>
                <li>صدور بلیط، هماهنگی سفر با راننده و پشتیبانی مسافر.</li>
                <li>ارسال پیامک یا تماس ضروری مربوط به رزرو، تغییرات سفر یا وضعیت پرداخت.</li>
                <li>پیشگیری از سوءاستفاده، تقلب و رعایت الزامات قانونی.</li>
                <li>بهبود کیفیت خدمات و تجربه رزرو (به‌صورت تجمیعی و در حد امکان بدون شناسایی مستقیم).</li>
            </ul>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">اشتراک‌گذاری اطلاعات</h2>
            <p>
                اطلاعات شما فقط در حد لازم برای انجام سفر و پشتیبانی با طرف‌های مرتبط (مانند راننده، اپراتور هماهنگی،
                درگاه پرداخت و سامانه‌های پیامکی) به اشتراک گذاشته می‌شود.
            </p>
            <p>
                اطلاعات شخصی شما را به اشخاص ثالث برای مقاصد تبلیغاتی نمی‌فروشیم. در صورت الزام قانونی، ممکن است
                اطلاعات به مراجع ذی‌صلاح ارائه شود.
            </p>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">نگهداری و امنیت</h2>
            <p>
                اطلاعات برای مدت لازم جهت ارائه خدمات، پیگیری مالی و الزامات قانونی نگهداری می‌شود.
                دسترسی به اطلاعات محدود به افراد مجاز است و از تدابیر متعارف امنیتی برای حفاظت از داده‌ها استفاده می‌شود.
            </p>
            <p>
                ارتباط با سامانه از طریق HTTPS انجام می‌شود تا انتقال داده بین مرورگر شما و سرور محافظت شود.
            </p>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">کوکی و فناوری‌های مشابه</h2>
            <p>
                برای حفظ نشست ورود، ترجیحات ضروری و عملکرد صحیح سایت ممکن است از کوکی استفاده شود.
                می‌توانید کوکی‌ها را در تنظیمات مرورگر مدیریت کنید؛ غیرفعال‌کردن برخی کوکی‌ها ممکن است بخش‌هایی از سامانه را مختل کند.
            </p>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">حقوق شما</h2>
            <ul>
                <li>درخواست مشاهده یا اصلاح اطلاعات پروفایل از طریق حساب کاربری یا پشتیبانی.</li>
                <li>درخواست راهنمایی درباره داده‌های مرتبط با رزروهای شما.</li>
                <li>انصراف از پیام‌های غیرضروری بازاریابی (پیام‌های ضروری سفر همچنان ارسال می‌شود).</li>
            </ul>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">به‌روزرسانی این سیاست</h2>
            <p>
                ممکن است این صفحه گاه‌به‌گاه به‌روز شود. نسخه جدید از طریق همین آدرس در دسترس خواهد بود.
                ادامه استفاده از خدمات پس از انتشار تغییرات به‌معنای آگاهی از نسخه به‌روز است.
            </p>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">تماس</h2>
            <p>
                برای سوال درباره حریم شخصی با پشتیبانی مسترشوفر در ارتباط باشید:
                تلفن <a href="tel:+982128422243" dir="ltr">۰۲۱-۲۸۴۲۲۲۴۳</a>
                یا ایمیل <a href="mailto:support@mrshoofer.ir">support@mrshoofer.ir</a>
                و صفحه <a href="/Home/ContactUs">ارتباط با ما</a>.
            </p>
        </article>

        <div class="legal-page-cta">
            <a asp-area="AgencyArea" asp-controller="Home" asp-action="ContactUs" class="btn btn-outline-primary rounded-pill px-4">
                <i class="ti ti-headset me-1"></i>ارتباط با پشتیبانی
            </a>
        </div>
    </div>
</section>
