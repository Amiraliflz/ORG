@{
    Layout = "_FrontLayout";
    ViewData["UseFullTabler"] = false;
    ViewData["Title"] = "ارتباط با ما";
    ViewData["MetaDescription"] = "ارتباط با پشتیبانی مسترشوفر — پیام بگذارید یا از طریق ایمیل و راه‌های ارتباطی سایت با ما در تماس باشید.";
    ViewData["CanonicalUrl"] = SeoDefaults.BuildCanonical("/Home/ContactUs");
    ViewData["DateModified"] = "2026-08-14";
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
      ("صفحه اصلی", SeoDefaults.BuildCanonical("/")),
      ("ارتباط با ما", SeoDefaults.BuildCanonical("/Home/ContactUs"))
    };
}

@section PageStyles {
    <link href="~/css/RoutePages.css?v=19" rel="stylesheet" />
}

<section class="section-py route-hub legal-page">
    <div class="container" style="max-width: 52rem">
        <nav class="route-breadcrumbs" aria-label="breadcrumb">
            <ol>
                <li><a href="/">صفحه اصلی</a></li>
                <li aria-current="page">ارتباط با ما</li>
            </ol>
        </nav>

        <header class="route-hub-header">
            <h1 class="route-hub-title">ارتباط با ما</h1>
            <p class="route-hub-lead">
                پشتیبانی ۲۴ ساعته برای رزرو، کنسلی، هماهنگی سفر یا همکاری — پیام بگذارید یا تماس بگیرید.
            </p>
        </header>

        <div class="legal-contact-grid">
            <div>
                <h2 class="route-hub-subtitle route-hub-subtitle--flush">راه‌های ارتباطی</h2>
                <div class="legal-contact-channel">
                    <div class="legal-contact-icon" aria-hidden="true"><i class="ti ti-phone"></i></div>
                    <div>
                        <p class="legal-contact-label">تلفن پشتیبانی</p>
                        <p class="legal-contact-value" dir="ltr"><a href="tel:+982128422243">021-28422243</a></p>
                    </div>
                </div>
                <div class="legal-contact-channel">
                    <div class="legal-contact-icon" aria-hidden="true"><i class="ti ti-mail"></i></div>
                    <div>
                        <p class="legal-contact-label">ایمیل</p>
                        <p class="legal-contact-value" dir="ltr"><a href="mailto:support@mrshoofer.ir">support@mrshoofer.ir</a></p>
                    </div>
                </div>
            </div>

            <article class="route-hub-panel">
                <h2 class="route-hub-subtitle route-hub-subtitle--flush">ارسال پیام</h2>
                <p>
                    برای پیگیری رزرو، کنسلی، پیشنهاد یا همکاری بنویسید. معمولاً در همان روز پاسخ می‌دهیم؛ برای موضوع فوری همان سفر با تلفن تماس بگیرید.
                </p>

                <div id="contact-success">
                    <i class="ti ti-circle-check me-2"></i>
                    پیام شما با موفقیت ارسال شد. به زودی با شما تماس می‌گیریم.
                </div>

                <form id="contact-form" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="contact-name">نام و نام خانوادگی</label>
                        <input type="text" id="contact-name" class="form-control" placeholder="نام شما" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="contact-phone">شماره موبایل</label>
                        <input type="tel" id="contact-phone" class="form-control" placeholder="09xxxxxxxxx" dir="ltr" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="contact-message">پیام</label>
                        <textarea id="contact-message" class="form-control" rows="5" placeholder="پیام خود را بنویسید..." required style="resize:none"></textarea>
                    </div>
                    <button type="submit" id="contact-submit" class="btn btn-primary w-100 rounded-pill" style="height:3rem">
                        <span id="contact-submit-text">ارسال پیام</span>
                        <span id="contact-submit-spinner" class="spinner-border spinner-border-sm ms-2" style="display:none"></span>
                    </button>
                </form>
            </article>
        </div>
    </div>
</section>

@section PageScripts {
<script>
document.getElementById('contact-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    var name = document.getElementById('contact-name').value.trim();
    var phone = document.getElementById('contact-phone').value.trim();
    var msg = document.getElementById('contact-message').value.trim();

    if (!name || !phone || !msg) {
        alert('لطفاً همه فیلدها را پر کنید');
        return;
    }

    var btn = document.getElementById('contact-submit');
    var spinner = document.getElementById('contact-submit-spinner');
    btn.disabled = true;
    spinner.style.display = 'inline-block';

    try {
        var resp = await fetch('/Message', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, number: phone, message: msg })
        });

        if (resp.ok) {
            document.getElementById('contact-form').style.display = 'none';
            document.getElementById('contact-success').style.display = 'block';
        } else {
            alert('خطا در ارسال پیام. لطفاً دوباره تلاش کنید.');
            btn.disabled = false;
            spinner.style.display = 'none';
        }
    } catch {
        alert('خطا در اتصال. لطفاً دوباره تلاش کنید.');
        btn.disabled = false;
        spinner.style.display = 'none';
    }
});
</script>
}
