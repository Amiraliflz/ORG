@{
    Layout = "_FrontLayout";
    ViewData["UseFullTabler"] = false;
    ViewData["Title"] = "قوانین سفر";
    ViewData["MetaDescription"] = "قوانین و شرایط سفر، کنسلی و استفاده از خدمات سواری بین‌شهری مسترشوفر را قبل از رزرو مطالعه کنید.";
    ViewData["CanonicalUrl"] = SeoDefaults.BuildCanonical("/Home/TravelPolicy");
    ViewData["DateModified"] = "2026-08-14";
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
      ("صفحه اصلی", SeoDefaults.BuildCanonical("/")),
      ("قوانین سفر", SeoDefaults.BuildCanonical("/Home/TravelPolicy"))
    };
}

@section PageStyles {
    <link href="~/css/RoutePages.css?v=19" rel="stylesheet" />
}

<section class="section-py route-hub legal-page">
    <div class="container" style="max-width: 46rem">
        <nav class="route-breadcrumbs" aria-label="breadcrumb">
            <ol>
                <li><a href="/">صفحه اصلی</a></li>
                <li aria-current="page">قوانین سفر</li>
            </ol>
        </nav>

        <header class="route-hub-header">
            <h1 class="route-hub-title">قوانین سفر</h1>
            <p class="route-hub-lead">
                شرایط رزرو، کنسلی، ظرفیت دربستی و هماهنگی مبدأ و مقصد در مسترشوفر — قبل از خرید بلیط بخوانید.
            </p>
        </header>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">شرایط کلی سفر</h2>
            <p>
                این قوانین برای رزرو سواری بین‌شهری، سرویس دربستی و ترانسفر فرودگاهی از طریق مسترشوفر اعمال می‌شود.
                با تکمیل رزرو، این شرایط را می‌پذیرید.
            </p>
            <p>
                ظرفیت خودرو دربستی ۳ مسافر است. سرویس اشتراکی یعنی رزرو صندلی در خودرویی که ممکن است مسافر دیگر هم داشته باشد.
            </p>
            <p>
                تغییر مبدأ یا مقصد، توقف اضافه، یا مسیر خارج از شهر مبدأ/مقصد فقط با هماهنگی راننده ممکن است و هزینه آن جدا محاسبه می‌شود.
            </p>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">قوانین کنسلی</h2>
            <p>در صورت انصراف، جریمه بر اساس زمان باقی‌مانده تا سفر محاسبه می‌شود:</p>
            <ul class="legal-cancel-list">
                <li>
                    <span class="legal-cancel-when">تا ۱ ساعت بعد از خرید</span>
                    <span class="legal-cancel-value">بدون جریمه</span>
                </li>
                <li>
                    <span class="legal-cancel-when">تا ۱۲ ساعت مانده به سفر</span>
                    <span class="legal-cancel-value">۲۰٪ جریمه</span>
                </li>
                <li>
                    <span class="legal-cancel-when">تا ۳ ساعت قبل از سفر</span>
                    <span class="legal-cancel-value">۵۰٪ جریمه</span>
                </li>
                <li class="is-blocked">
                    <span class="legal-cancel-when">کمتر از ۳ ساعت مانده به سفر</span>
                    <span class="legal-cancel-value">امکان کنسلی وجود ندارد</span>
                </li>
            </ul>
            <p>
                استرداد طبق همین فهرست و پس از ثبت درخواست کنسلی انجام می‌شود. اگر کمتر از ۳ ساعت به سفر مانده باشد، امکان کنسلی وجود ندارد.
            </p>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">هماهنگی مبدأ و مقصد</h2>
            <p>
                پس از تأیید بلیط، مکان دقیق سوار و پیاده شدن را تیم مسترشوفر با مسافر هماهنگ می‌کند. شماره تماس مسافر باید صحیح باشد؛ در غیر این صورت هماهنگی سفر ممکن است با تأخیر یا اختلال روبه‌رو شود.
            </p>
            <p>
                برای ترانسفر فرودگاهی، ساعت پرواز را هنگام هماهنگی اعلام کنید تا زمان حضور در مبدأ با پرواز هم‌خوان باشد.
            </p>
        </article>

        <article class="route-hub-panel">
            <h2 class="route-hub-subtitle route-hub-subtitle--flush">مسئولیت‌ها</h2>
            <ul>
                <li>مسافر باید رأس ساعت هماهنگ‌شده در محل مبدأ حاضر باشد.</li>
                <li>همراه داشتن مدرک شناسایی معتبر هنگام سوار شدن الزامی است.</li>
                <li>مسترشوفر در قبال تأخیر ناشی از عوامل خارج از کنترل (ترافیک، شرایط جوی، حوادث جاده‌ای) مسئولیتی ندارد.</li>
                <li>بار همراه باید متناسب با فضای خودرو باشد؛ هماهنگی بار اضافه را قبل از سفر با پشتیبانی مطرح کنید.</li>
            </ul>
        </article>

        <div class="legal-page-cta">
            <a asp-area="AgencyArea" asp-controller="Home" asp-action="ContactUs" class="btn btn-outline-primary rounded-pill px-4">
                <i class="ti ti-headset me-1"></i>سوال دارید؟ تماس بگیرید
            </a>
        </div>
    </div>
</section>
