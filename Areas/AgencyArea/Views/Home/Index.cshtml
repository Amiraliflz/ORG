    <section id="landingFAQ" class="section-py bg-body landing-faq">
        <div class="container">
            <div class="text-center mb-3 pb-1">
                <span class="badge bg-label-primary">سوالات</span>
            </div>
            <h3 class="text-center mb-1">
                <span class="section-title">سوالات پرتکرار</span>
            </h3>
            <p class="text-center mb-5 pb-3">پاسخ‌های کوتاه درباره رزرو سواری بین‌شهری و ترانسفر فرودگاهی با مستر شوفر</p>
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="accordion" id="accordionHomeFaq">
                        @{
                            var faqs = Application.Services.Seo.SeoDefaults.HomeFaqs;
                            for (var i = 0; i < faqs.Length; i++)
                            {
                                var item = faqs[i];
                                var headingId = $"faqHeading{i}";
                                var collapseId = $"faqCollapse{i}";
                                var isFirst = i == 0;
                                <div class="card accordion-item @(isFirst ? "active" : "")">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button type="button"
                                                class="accordion-button @(isFirst ? "" : "collapsed")"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="@(isFirst ? "true" : "false")"
                                                aria-controls="@collapseId">
                                            @item.Question
                                        </button>
                                    </h2>
                                    <div id="@collapseId"
                                         class="accordion-collapse collapse @(isFirst ? "show" : "")"
                                         aria-labelledby="@headingId"
                                         data-bs-parent="#accordionHomeFaq">
                                        <div class="accordion-body">@item.Answer</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- FAQ: End -->
    <!-- CTA: Start -->
    <section id="landingCTA" class="section-py landing-cta position-relative p-lg-0 pb-0 landing-cta-band">
        <div class="container">
            <div class="row align-items-center gy-5 gy-lg-0">
                <div class="col-lg-6 text-center text-lg-start">
                    <h6 class="h2 text-primary fw-bold mb-3">برای شروع آماده‌اید؟</h6>
                    <p class="fw-medium mb-4 fs-5">مبدأ و مقصد را جستجو کنید و بلیط خود را در کمتر از چند دقیقه بگیرید.</p>
                    <a href="#landingHero" class="btn btn-lg btn-primary">جستجوی سواری</a>
                </div>
                <div class="col-lg-6 pt-lg-5 text-center text-lg-end">
                    <img src="/mrshooferserachdemo.png" alt="نمایش جستجوی سواری در مسترشوفر" class="img-fluid landing-cta-img" />
                </div>
            </div>
        </div>
    </section>
    <!-- CTA: End -->
    <!-- Contact Us: Start -->
    <section id="landingContact" class="section-py bg-body landing-contact">
        <div class="container">
            <div class="text-center mb-3 pb-1">
                <span class="badge bg-label-primary">ارتباط با ما</span>
            </div>
            <h3 class="text-center mb-3 fw-medium">
                <span class="position-relative fw-bold z-1 section-title">
                    ارتباط مستقیم با مسترشوفر
                </span>

            </h3>
            <p class="text-center mb-4 mb-lg-5 pb-md-3">برای ارتباط مستقیم با مستر شوفر، از قسمت زیر استفاده کنید</p>
            <div class="row gy-4">
                <div class="col-lg-5">
                    <div class="contact-img-box position-relative border p-2 h-100">
                        <img src="~/img/front-pages/icons/contact-border.png" alt="contact border" class="contact-border-img position-absolute d-none d-md-block scaleX-n1-rtl" />
                        <img src="/callcenter.jpg " alt="contact customer service" class="contact-img w-100 scaleX-n1-rtl" />
                        <div class="pt-3 px-4 pb-1">
                            <div class="row gy-3 gx-md-4">
                                <div class="col-md-6 col-lg-12 col-xl-6">
                                    <div class="d-flex align-items-center">
                                        <div class="badge bg-label-primary rounded p-2 me-2"><i class="ti ti-mail ti-sm"></i></div>
                                        <div>
                                            <p class="mb-1">ایمیل</p>
                                            <h5 class="mb-0">
                                                <a href="mailto:info@mrshoofer.ir" class="text-heading">info@mrshoofer.ir</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-12 col-xl-6">
                                    <div class="d-flex align-items-center">
                                        <div class="badge bg-label-success rounded p-2 me-2">
                                            <i class="ti ti-phone-call ti-sm"></i>
                                        </div>
                                        <div>
                                            <p class="mb-1">تلفن</p>
                                            <h5 class="mb-0" dir="ltr"><a href="tel:+989902063015" class="text-heading">09902063015</a></h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="mb-2">ارتباط با مسترشوفر</h4>
                            <p class="mb-4">
                                اگر صحبتی با ما دارید لطفا در باکس زیر بنویسید مثل انتقادات و پیشنهادات ، همکاری،
                                <br class="d-none d-lg-block" />
                                و ... ما در خدمت شما هستیم.
                            </p>
                            <form id="contact-us">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label" for="contact-form-fullname">نام و نام خانوادگی</label>
                                        <input name="name" class="form-control" id="name" placeholder="نام خود را وارد کنید" type="text" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="contact-form-email">
                                            شماره تلفن

                                            <span class="text-danger">
                                                *
                                            </span>
                                        </label>
                                        <input required name="number" class="form-control" id="number" type="text" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="contact-form-message">پیام
                                            <span class="text-danger">
                                                *
                                            </span>
                                        </label>
                                        <textarea required name="message" class="form-control" id="message" placeholder="پیام خود را بنویسید" rows="8"></textarea>
                                    </div>
                                    <div class="col-12">
                                        <button class="btn btn-primary" type="submit">ارسال پیام</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Contact Us: End -->
</div>


<script>
    $(document).ready(function () {
        $('#contact-us').on('submit', function (event) {
            event.preventDefault();

            var name = $('#name').val();
            var number = $('#number').val();
            var message = $('#message').val();



            $.ajax({
                url: '/Message',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ name: name, number: number, message: message }),

                success: function (response) {
                    Swal.fire({
                        title: 'پیام شما ثبت شد',
                        text: 'با تشکر از شما، پیام شما در اسرع وقت و با ارجعیت، توسط کارشناسان ما برسی خواهد شد.',
                        confirmButtonText: 'باشه',
                        icon: 'success',
                        customClass: {
                            confirmButton: 'btn btn-primary waves-effect waves-light'
                        },
                        buttonsStyling: false
                    });
                    // Optionally, clear the form fields
                    $('#contact-us')[0].reset();
                },
                error: function (xhr, status, error) {
                    $('#contact-us')[0].reset();

                    Swal.fire({
                        icon: "error",
                        title: "پیام شما ثبت نشد",
                        text: "پیام شما در سیستم ثبت نشد",
                    });
                }
            });
            
        });
    });
</script>
