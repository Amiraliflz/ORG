@inject IHomepageCatalogCache HomepageCatalog
@{
    Layout = "_FrontLayout";

    ViewData["Title"] = "رزرو تاکسی بین شهری و سواری دربستی";
    ViewData["MetaDescription"] = "رزرو آنلاین تاکسی بین شهری، سواری دربستی و ترانسفر فرودگاهی با مستر شوفر (مسترشوفر) — ناوگان تأییدشده، بلیط در چند دقیقه و پشتیبانی ۲۴/۷";
    ViewData["OgTitle"] = "مستر شوفر | تاکسی بین شهری و سواری دربستی";
    ViewData["OgDescription"] = (string)ViewData["MetaDescription"]!;
    ViewData["OgImage"] = Application.Services.Seo.SeoDefaults.DefaultOgImageUrl;
    ViewData["OgImageAlt"] = "مستر شوفر — رزرو آنلاین تاکسی بین شهری و سواری دربستی";
    ViewData["CanonicalUrl"] = SeoDefaults.BuildCanonical("/");
    ViewData["IncludeHomeFaqs"] = true;
    ViewData["IncludeSiteNav"] = true;
    ViewData["DateModified"] = "2026-08-14";
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
      ("صفحه اصلی", SeoDefaults.BuildCanonical("/"))
    };
}

@section VendorStyles {
    <link href="~/vendor/css/pages/front-page-landing.css" rel="stylesheet" />
    <link href="~/css/IndexPage.css" rel="stylesheet" asp-append-version="true" />
    <link rel="preload" href="/img/front-pages/landing-page/hero-travel.webp?v=3" as="image" type="image/webp" imagesrcset="/img/front-pages/landing-page/hero-travel.webp?v=3 1600w, /img/front-pages/landing-page/hero-travel@2x.webp?v=3 2560w" imagesizes="100vw" fetchpriority="high" />
}

@section VendorScripts {
    <script src="~/libs/jquery.js"></script>
    <script src="~/js/index-page.js" asp-append-version="true"></script>
}


<div data-bs-spy="scroll" class="scrollspy-example">

    <!-- Hero: Start -->
    <section id="hero-animation">
        <div id="landingHero" class="landing-hero position-relative">
            @* Pateh-style: art fills the stage band; search overlaps the bottom edge *@
            <div class="landing-hero-stage">
                <div class="landing-hero-stage-art" aria-hidden="true">
                    <picture>
                        <source
                            srcset="/img/front-pages/landing-page/hero-travel.webp?v=3 1600w, /img/front-pages/landing-page/hero-travel@2x.webp?v=3 2560w"
                            sizes="100vw"
                            type="image/webp" />
                        <img
                            src="/img/front-pages/landing-page/hero-travel.jpg?v=3"
                            srcset="/img/front-pages/landing-page/hero-travel.jpg?v=3 1600w, /img/front-pages/landing-page/hero-travel@2x.jpg?v=3 2560w"
                            sizes="100vw"
                            alt=""
                            width="1600"
                            height="800"
                            class="landing-hero-stage-art-img"
                            fetchpriority="high"
                            decoding="async" />
                    </picture>
                </div>
                <div class="container landing-hero-stage-content">
                    <h1 class="visually-hidden">مستر شوفر — راهی مطمئن به همه مقاصد ایران</h1>
                    <div class="hero-text-box text-center">
                    </div>
                </div>
            </div>

            <div class="container landing-hero-search-wrap">
                <div class="hero-safezone hero-safezone--form">
                    <div class="ride-sheet" id="tripForm">
                        <a class="ride-sheet__hit" href="/Reserve/MapBook" id="mapBookEntryLink" aria-label="شروع رزرو روی نقشه">
                            <div class="ride-sheet__row ride-sheet__row--origin">
                                <span class="ride-sheet__dot ride-sheet__dot--origin" aria-hidden="true"></span>
                                <span class="ride-sheet__labels">
                                    <span class="ride-sheet__label">مبدأ</span>
                                    <span class="ride-sheet__value">روی نقشه مشخص می‌کنید</span>
                                </span>
                            </div>
                            <div class="ride-sheet__divider" aria-hidden="true"></div>
                            <div class="ride-sheet__row ride-sheet__row--dest">
                                <span class="ride-sheet__dot ride-sheet__dot--dest" aria-hidden="true"></span>
                                <span class="ride-sheet__labels">
                                    <span class="ride-sheet__label">مقصد</span>
                                    <span class="ride-sheet__value ride-sheet__value--strong">مقصد کجاست؟</span>
                                </span>
                                <i class="ti ti-search ride-sheet__search" aria-hidden="true"></i>
                            </div>
                        </a>
                        <a class="btn btn-primary ride-sheet__go" href="/Reserve/MapBook">
                            بزن بریم
                            <i class="ti ti-arrow-left" aria-hidden="true"></i>
                        </a>
                        <p class="ride-sheet__trust">
                            <i class="ti ti-shield-check" aria-hidden="true"></i>
                            راننده تأییدشده · قیمت قبل از پرداخت · پشتیبانی ۲۴/۷
                        </p>
                    </div>

                    <!-- Trust stats -->
                    <div class="hero-trust-stats">
                        <div class="hero-trust-stat">
                            <i class="ti ti-route" aria-hidden="true"></i>
                            <span><strong>۵۰۰+</strong> مسیر فعال</span>
                        </div>
                        <div class="hero-trust-stat">
                            <i class="ti ti-steering-wheel" aria-hidden="true"></i>
                            <span><strong>۱۲۰۰+</strong> راننده تأییدشده</span>
                        </div>
                        <div class="hero-trust-stat">
                            <i class="ti ti-headset" aria-hidden="true"></i>
                            <span>پشتیبانی <strong>۲۴/۷</strong></span>
                        </div>
                        <div class="hero-trust-stat">
                            <i class="ti ti-shield-check" aria-hidden="true"></i>
                            <span>سفر <strong>مطمئن</strong> و بیمه‌شده</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container landing-hero-below">
                <!-- Definition CTA — wide (matches page shell), not constrained like the form -->
                <div class="hero-safezone hero-safezone--wide">
                    <div class="hero-definition-cta" id="aboutMrShoofer">
                                <div class="hero-definition-content">
                                    <h2 class="hero-definition-title">مستر شوفر</h2>
                                    <p class="hero-definition-tagline">سامانه رزرو آنلاین تاکسی بین‌شهری</p>
                                    <p class="hero-definition-body">
                                        مستر شوفر (همان مسترشوفر) سامانه رزرو آنلاین تاکسی بین شهری، سواری دربستی و ترانسفر فرودگاهی با ناوگان سواری است. سفر خود را از بین کلاس‌های متنوع ما انتخاب کنید و بلیط خود را در کمتر از چند دقیقه دریافت کنید. همکاران ما در سریع‌ترین زمان ممکن برای هماهنگی سفر با شما تماس می‌گیرند و تا آخرین لحظه سفر در کنار شما هستند تا تجربه‌ای با آرامش خاطر و امنیت رقم بخورد.
                                    </p>
                                    <div class="hero-definition-mid">
                                        <div class="hero-definition-media">
                                            <img src="/cta-taxi.webp" alt="ناوگان سواری مستر شوفر" width="480" height="270" loading="lazy" decoding="async" class="hero-definition-img" />
                                        </div>
                                        <div class="hero-definition-aside">
                                            <ul class="hero-definition-bullets">
                                                <li>رزرو سفر دلخواه در کمتر از چند دقیقه</li>
                                                <li>ناوگان سواری با رانندگان مجرب و تأییدشده</li>
                                                <li>پشتیبانی ۲۴/۷ تا آخرین لحظه سفر</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <a href="/Reserve/MapBook" class="btn btn-primary btn-lg hero-definition-btn">
                                        بزن بریم
                                        <i class="ti ti-map-2" aria-hidden="true"></i>
                                    </a>
                                </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
    <!-- Hero: End -->
    <!-- How to book -->
    <section id="landingHowTo" class="section-py bg-body landing-howto">
        <div class="container">
            <header class="landing-section-intro">
                <span class="badge bg-label-primary">راهنمای رزرو</span>
                <h2 class="fw-medium">
                    رزرو در <span class="section-title">چهار قدم</span>
                </h2>
                <p class="landing-section-lead text-muted">
                    روی نقشه مبدأ و مقصد را مشخص کنید، کلاس را انتخاب کنید و بلیط را در چند دقیقه بگیرید.
                </p>
            </header>
            <ol class="landing-howto-steps">
                @{
                    var howToSteps = SeoDefaults.BookingHowToSteps;
                    var howToNums = new[] { "۱", "۲", "۳", "۴" };
                    var howToEmojis = new[] { "📍", "📅", "🚗", "🎫" };
                    for (var i = 0; i < howToSteps.Length; i++)
                    {
                        <li class="landing-howto-step">
                            <span class="landing-howto-num" aria-hidden="true">@howToNums[i]</span>
                            <p class="landing-howto-title">
                                <span class="landing-howto-emoji" aria-hidden="true">@howToEmojis[i]</span>
                                @howToSteps[i].Title
                            </p>
                            <p class="landing-howto-text">@howToSteps[i].Text</p>
                        </li>
                    }
                }
            </ol>
            <div class="landing-howto-cta">
                <a href="/Reserve/MapBook" class="btn btn-primary">بزن بریم</a>
            </div>
        </div>
    </section>
    <!-- Popular routes (SEO internal links) -->
    <section id="landingRoutes" class="section-py landing-routes">
        <div class="container landing-routes-inner">
            <header class="landing-section-intro">
                <span class="badge bg-label-primary">مسیرهای پرتردد</span>
                <h2 class="fw-medium">
                    رزرو سواری در <span class="section-title">مسیرهای محبوب</span>
                </h2>
                <p class="landing-section-lead text-muted landing-routes-lead">
                    صفحه اختصاصی هر مسیر را ببینید و همان‌جا جستجو را شروع کنید
                </p>
            </header>
            @{
                var popularRoutes = SeoDefaults.HomepagePopularRoutes();
                var popularCities = SeoDefaults.HomepagePopularCities();
            }
            <ul class="landing-routes-grid">
                @foreach (var r in popularRoutes)
                {
                    var startPrice = HomepageCatalog.GetRouteStartingPrice(r.Slug);
                    <li>
                        <a class="landing-route-link" href="/routes/@r.Slug">
                            <span class="landing-route-od">
                                <span class="landing-route-city">@r.OriginFa</span>
                                <span class="landing-route-arrow" aria-hidden="true">←</span>
                                <span class="landing-route-city">@r.DestinationFa</span>
                            </span>
                            <span class="landing-route-meta">
                                @if (startPrice is long price)
                                {
                                    <span class="landing-route-price">
                                        <span class="landing-route-price-label">شروع قیمت</span>
                                        <span class="landing-route-price-value">@price.ToString("N0") تومان</span>
                                    </span>
                                }
                                <span class="landing-route-hint">مشاهده و رزرو</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>

            @if (popularCities.Count > 0)
            {
                <div class="landing-routes-cities-wrap">
                    <p class="landing-routes-cities-label">کاوش بر اساس شهر</p>
                    <ul class="landing-routes-cities">
                        @foreach (var c in popularCities)
                        {
                            <li>
                                <a href="/cities/@c.Slug">@c.NameFa</a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="landing-routes-actions">
                <a href="/routes" class="btn btn-outline-primary">مشاهده همه مسیرها</a>
                <a href="/cities" class="btn btn-outline-secondary">همه شهرها</a>
            </div>
        </div>
    </section>
    <!-- Popular routes: End -->

    <!-- Useful features: Start -->
    <section id="landingFeatures" class="section-py landing-features">
        <div class="container">
            <header class="landing-section-intro">
                <span class="badge bg-label-primary">تاکسی بین شهری، سواری دربستی و ترانسفر فرودگاهی</span>
                <h2 class="fw-medium">
                    چرا <span class="section-title">مسترشوفر</span>؟
                </h2>
                <p class="landing-section-lead text-muted">
                    رانندگان تأییدشده، خودروهای باکیفیت و پشتیبانی ۲۴ ساعته — همه چیز برای یک سفر بدون دغدغه
                </p>
            </header>
            <div class="features-icon-wrapper row g-4">
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <span class="feature-line-icon feature-line-icon--sky" role="img" aria-label="رزرو آنلاین سواری از موبایل و لپ‌تاپ"></span>
                    </div>
                    <p class="mb-2 fw-semibold">رزرو آسان، هر جا هستید</p>
                    <p class="features-icon-description">از هر دستگاهی در چند ثانیه سواری رزرو کنید — بدون تماس تلفنی و بدون انتظار در صف.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <img src="/taxi.webp" height="66" width="66" alt="ناوگان سواری بین‌شهری مسترشوفر" loading="lazy" decoding="async" />
                    </div>
                    <p class="mb-2 fw-semibold">ناوگان گسترده در سراسر ایران</p>
                    <p class="features-icon-description">صدها مسیر بین‌شهری و ترانسفر فرودگاهی با ظرفیت بالا؛ همیشه گزینه‌ای برای سفر شما هست.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <span class="feature-line-icon feature-line-icon--clay" role="img" aria-label="صدور سریع بلیط سفر"></span>
                    </div>
                    <p class="mb-2 fw-semibold">بلیط فوری، تأیید آنی</p>
                    <p class="features-icon-description">پس از رزرو، بلیط تأییدشده را سریع دریافت می‌کنید؛ بدون ابهام و بدون انتظار طولانی.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <span class="feature-line-icon feature-line-icon--sage" role="img" aria-label="راننده و خودرو تأییدشده"></span>
                    </div>
                    <p class="mb-2 fw-semibold">رانندگان و خودروهای تأییدشده</p>
                    <p class="features-icon-description">هر راننده پیش از فعالیت احراز هویت می‌شود تا با اطمینان و آرامش سوار شوید.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <span class="feature-line-icon feature-line-icon--mist" role="img" aria-label="پشتیبانی مشتریان مسترشوفر"></span>
                    </div>
                    <p class="mb-2 fw-semibold">پشتیبانی ۲۴ ساعته</p>
                    <p class="features-icon-description">تیم پشتیبانی تا آخرین لحظه سفر همراه شماست — حتی در میانه شب یا روز تعطیل.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <span class="feature-line-icon feature-line-icon--sand" role="img" aria-label="سفر دربستی اختصاصی"></span>
                    </div>
                    <p class="mb-2 fw-semibold">سفر دربستی</p>
                    <p class="features-icon-description">خودرو در اختیار شماست — سرویس دربستی اختصاصی، بدون همسفر ناشناس.</p>
                </div>
            </div>
        </div>
    </section>
    <!-- Useful features: End -->
