@section PageScripts {
<script>
(function () {
  function loadSweetAlert() {
    return new Promise(function (resolve) {
      if (window.Swal) {
        resolve();
        return;
      }
      if (!document.getElementById('sweetalert2-css')) {
        var css = document.createElement('link');
        css.id = 'sweetalert2-css';
        css.rel = 'stylesheet';
        css.href = '/vendor/libs/sweetalert2/sweetalert2.css';
        document.head.appendChild(css);
      }
      var s = document.createElement('script');
      s.src = '/vendor/libs/sweetalert2/sweetalert2.js';
      s.onload = function () { resolve(); };
      document.body.appendChild(s);
    });
  }

  $(function () {
    $('#contact-us').on('submit', function (event) {
      event.preventDefault();
      var name = $('#name').val();
      var number = $('#number').val();
      var message = $('#message').val();

      $.ajax({
        url: '/Message',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ name: name, number: number, message: message }),
        success: function () {
          loadSweetAlert().then(function () {
            Swal.fire({
              title: 'پیام شما ثبت شد',
              text: 'با تشکر از شما، پیام شما در اسرع وقت و با ارجعیت، توسط کارشناسان ما برسی خواهد شد.',
              confirmButtonText: 'باشه',
              icon: 'success',
              customClass: { confirmButton: 'btn btn-primary' },
              buttonsStyling: false
            });
          });
          $('#contact-us')[0].reset();
        },
        error: function () {
          $('#contact-us')[0].reset();
          loadSweetAlert().then(function () {
            Swal.fire({
              icon: 'error',
              title: 'پیام شما ثبت نشد',
              text: 'پیام شما در سیستم ثبت نشد'
            });
          });
        }
      });
    });
  });
})();
</script>
}
