@{
    Layout = "_FrontLayout";

    ViewData["Title"] = "رزرو تاکسی بین شهری و سواری دربستی";
    ViewData["MetaDescription"] = "رزرو آنلاین تاکسی بین شهری، سواری دربستی و ترانسفر فرودگاهی با مستر شوفر (مسترشوفر) — ناوگان تأییدشده، بلیط در چند دقیقه و پشتیبانی ۲۴/۷";
    ViewData["OgTitle"] = "مستر شوفر | تاکسی بین شهری و سواری دربستی";
    ViewData["OgDescription"] = (string)ViewData["MetaDescription"]!;
    ViewData["OgImage"] = Application.Services.Seo.SeoDefaults.DefaultOgImageUrl;
    ViewData["OgImageAlt"] = "مستر شوفر — رزرو آنلاین تاکسی بین شهری و سواری دربستی";
    ViewData["CanonicalUrl"] = "https://sale.shoofer.taxi/";
    ViewData["IncludeHomeFaqs"] = true;
    ViewData["DateModified"] = "2026-08-09";
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
      ("صفحه اصلی", "https://sale.shoofer.taxi/")
    };
}

@section VendorStyles {
    <link href="~/vendor/css/pages/front-page-landing.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.css" />
    <link rel="stylesheet" href="~/vendor/libs/jquery-timepicker/jquery-timepicker.css" />
    <link rel="stylesheet" href="~/vendor/libs/pickr/pickr-themes.css" />
    <link href="~/css/IndexPage.css?v=32" rel="stylesheet" />
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/vendor/libs/animate-css/animate.css" />
    @* Critical: swap control + field gutters (survive stale/CDN-cached IndexPage.css) *@
    <style>
      .landing-hero .od-pair-col { position: relative; }
      .landing-hero #tripForm .od-pair { --od-swap-gutter: 2.75rem; }
      .landing-hero #tripForm .od-pair > .inputcel:first-child {
        padding-inline-end: calc(var(--od-swap-gutter) / 2) !important;
      }
      .landing-hero #tripForm .od-pair > .inputcel:last-of-type {
        padding-inline-start: calc(var(--od-swap-gutter) / 2) !important;
      }
      .landing-hero .od-swap-btn {
        --od-swap-size: 2rem;
        position: absolute !important;
        left: 50%;
        top: 0.55rem;
        transform: translateX(-50%);
        z-index: 4;
        width: var(--od-swap-size) !important;
        max-width: var(--od-swap-size) !important;
        height: var(--od-swap-size) !important;
        padding: 0 !important;
        margin: 0 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        border-radius: 0.85rem;
        border: 1px solid #d9dee3;
        background: #fff;
        color: #8592a3;
        line-height: 1;
        box-shadow: 0 0 0 4px #fff, 0 1px 2px rgba(47, 43, 61, 0.06);
        cursor: pointer;
      }
      .landing-hero .od-swap-btn .ti { font-size: 1rem; margin: 0; line-height: 1; }
      @@media (max-width: 767.98px) {
        .landing-hero #tripForm .od-pair { --od-swap-gutter: 2.35rem; }
        .landing-hero .od-swap-btn { top: 1.85rem; --od-swap-size: 1.85rem; }
      }
    </style>
}

@section VendorScripts {
    <script src="~/libs/jquery.js"></script>
    <script src="~/vendor/js/dropdown-hover.js"></script>
    <script src="~/vendor/libs/moment/moment.js"></script>
    <script src="~/vendor/libs/jdate/jdate.min.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr-jdate.js"></script>
    <script src="~/vendor/libs/flatpickr/l10n/fa.js"></script>
    <script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.js"></script>
    <script src="~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.js"></script>
    <script src="~/vendor/libs/jquery-timepicker/jquery-timepicker.js"></script>
    <script src="~/vendor/libs/pickr/pickr.js"></script>
    <script src="~/js/IndexPage.js"></script>
    <script src="~/js/searchpage.js?v=5"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/js/extended-ui-sweetalert2.js"></script>
}

