@{
    Layout = null;
    ViewData["Title"] = "مسترشوفر عملیات";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="manifest" href="/ops/manifest.json" />
    <link rel="apple-touch-icon" href="/ops/icons/icon-192.png" />
    <link rel="stylesheet" href="/farsi-fonts/font.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/front-palette.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/ops-monochrome.css" asp-append-version="true" />
    <title>@ViewData["Title"]</title>
</head>
<body class="ops-body ops-mobile">
    @RenderBody()
    <script src="/ops/monitor.js" asp-append-version="true"></script>
    @await RenderSectionAsync("PageScripts", required: false)
</body>
</html>
