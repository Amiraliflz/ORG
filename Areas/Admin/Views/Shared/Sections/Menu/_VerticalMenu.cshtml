@{
    TempData.Keep();



    string? currentPage = ViewContext.HttpContext.Request.Path;
}

<!-- Menu -->
@* ! Do this simple *@
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">

    @* ! Hide app brand if navbar-full *@
    <div class='app-brand demo @((@ViewData["navbarFull"] != null && Convert.ToBoolean(@ViewData["navbarFull"])) ? "d-xl-none" : "")'>
        <a asp-controller="Home" asp-action="Index" class="app-brand-link">
            <span class="app-brand-logo demo">
                <img height="30" src="/logo_mini.png" />
            </span>
            <span class="app-brand-text demo menu-text fw-bold">مسترشوفر</span>
        </a>

        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
            <i class="ti menu-toggle-icon d-none d-xl-block ti-sm align-middle"></i>
            <i class="ti ti-x d-block d-xl-none ti-sm align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    @* ! Starter Kit menu-items *@

    <ul class="menu-inner py-1">

        <li class='menu-item@(currentPage == "/Admin/Messages" ? " active" : "")'>
            <a asp-controller="Messages" asp-area="Admin" asp-action="Index" class="menu-link">
                <i class="ti ti-message menu-icon tf-icons"></i>
                <div>پیام‌ها</div>
            </a>
        </li>
        <li class='menu-item@(currentPage.StartsWith("/Admin/Customers") ? " active" : "")'>
            <a asp-controller="Customers" asp-area="Admin" asp-action="Index" class="menu-link">
                <i class="ti ti-users menu-icon tf-icons"></i>
                <div>مشتریان</div>
            </a>
        </li>
        <li class='menu-item@(currentPage.StartsWith("/Admin/CustomerWallet") ? " active" : "")'>
            <a asp-controller="CustomerWallet" asp-area="Admin" asp-action="Index" class="menu-link">
                <i class="ti ti-wallet menu-icon tf-icons"></i>
                <div>کیف پول مشتریان</div>
            </a>
        </li>
        <li class='menu-item@(currentPage.StartsWith("/Admin/DiscountCodes") ? " active" : "")'>
            <a asp-controller="DiscountCodes" asp-area="Admin" asp-action="Index" class="menu-link">
                <i class="ti ti-discount menu-icon tf-icons"></i>
                <div>کدهای تخفیف</div>
            </a>
        </li>
        @if (LoyaltyService.FeatureEnabled)
        {
        <li class='menu-item@(currentPage.StartsWith("/Admin/Loyalty") ? " active" : "")'>
            <a asp-controller="Loyalty" asp-area="Admin" asp-action="Index" class="menu-link">
                <i class="ti ti-award menu-icon tf-icons"></i>
                <div>وفاداری</div>
            </a>
        </li>
        }
        <li class='menu-item@(currentPage.StartsWith("/Admin/Ops") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="ti ti-activity menu-icon tf-icons"></i>
                <div>عملیات</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage.StartsWith("/Admin/Ops/Monitor") ? " active" : "")'>
                    <a asp-controller="Ops" asp-area="Admin" asp-action="Monitor" class="menu-link">
                        <div>مانیتور</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage.StartsWith("/Admin/Ops/Analytics") ? " active" : "")'>
                    <a asp-controller="Ops" asp-area="Admin" asp-action="Analytics" class="menu-link">
                        <div>آمار</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage.StartsWith("/Admin/Ops/Logs") ? " active" : "")'>
                    <a asp-controller="Ops" asp-area="Admin" asp-action="Logs" class="menu-link">
                        <div>گزارش‌ها</div>
                    </a>
                </li>
            </ul>
        </li>

    </ul>


</aside>
<!-- / Menu -->
