@model List<Application.Models.AppLogEntry>
@{
    ViewData["Title"] = "گزارش‌ها";
    var level = ViewBag.Level as string;
    var q = ViewBag.Query as string;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var total = (int)ViewBag.Total;
}

@section PageStyles {
<link rel="stylesheet" href="/css/ops-monochrome.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0">گزارش‌ها</h4>
            <small class="text-muted">@total رکورد</small>
        </div>
        <a href="/Admin/Ops/Monitor" class="btn btn-outline-dark btn-sm rounded-pill">مانیتور</a>
    </div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <select name="level" class="form-select">
                <option value="">همه سطوح</option>
                @if (level == "Error") { <option value="Error" selected>Error</option> } else { <option value="Error">Error</option> }
                @if (level == "Warning") { <option value="Warning" selected>Warning</option> } else { <option value="Warning">Warning</option> }
                @if (level == "Information") { <option value="Information" selected>Information</option> } else { <option value="Information">Information</option> }
            </select>
        </div>
        <div class="col-md-6">
            <input type="text" name="q" class="form-control" placeholder="جستجو در پیام، مسیر، دسته…" value="@q" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-dark w-100">جستجو</button>
        </div>
    </form>

    <div class="card border">
        <div class="table-responsive">
            <table class="ops-logs-table mb-0">
                <thead>
                    <tr>
                        <th>زمان</th>
                        <th>سطح</th>
                        <th>پیام</th>
                        <th>مسیر</th>
                        <th>ms</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var log in Model)
                {
                    var levelClass = log.Level == "Error" ? "ops-level-error"
                        : log.Level == "Warning" ? "ops-level-warning" : "";
                    <tr>
                        <td class="text-nowrap">@log.Timestamp.ToLocalTime().ToString("MM/dd HH:mm:ss")</td>
                        <td class="@levelClass">@log.Level</td>
                        <td style="max-width:360px; word-break:break-word;">@log.Message</td>
                        <td class="text-muted small">@log.RequestPath</td>
                        <td>@log.DurationMs</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (var p = 1; p <= totalPages && p <= 20; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link" href="?level=@level&q=@q&page=@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
