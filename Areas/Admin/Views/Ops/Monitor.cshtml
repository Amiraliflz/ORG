@{
    Layout = "_OpsMobileLayout";
    ViewData["Title"] = "مانیتور عملیات — مسترشوفر";
}

<div class="ops-header">
    <h1>مسترشوفر · عملیات</h1>
    <span id="opsOverallPill" class="ops-status-pill">…</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="ops-alert ops-alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="ops-alert ops-alert-error">@TempData["Error"]</div>
}

<div class="ops-hero">
    <div id="opsHeroDot" class="ops-hero-dot"></div>
    <h2 id="opsHeroText">در حال بررسی…</h2>
    <p class="ops-meta" id="opsUptime">آپتایم ۲۴ ساعت: —</p>
    <p class="ops-meta" id="opsLastCheck">آخرین بررسی: —</p>
</div>

<div id="opsComponents" class="ops-components"></div>

<div class="ops-actions">
    <button type="button" class="ops-btn ops-btn-primary" id="opsRefreshBtn">بروزرسانی</button>
    <a href="/Admin/Ops/Analytics" class="ops-btn">آمار</a>
    <a href="/Admin/Ops/Logs" class="ops-btn">گزارش‌ها</a>
</div>

<form id="opsRestartForm" method="post" action="/Admin/Ops/Restart" style="display:none; margin-top:1rem;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="confirm" value="RESTART" />
    <button type="submit" class="ops-btn ops-btn-danger" id="opsRestartBtn">
        راه‌اندازی مجدد سرویس
    </button>
</form>

<p class="ops-meta" style="text-align:center; margin-top:1.5rem;">
    اپ اندروید: <code>mobile/ops-android/app/build/outputs/apk/debug/app-debug.apk</code>
</p>

@section PageScripts {
<script>
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/ops/sw.js').catch(() => {});
}
</script>
}
